{
  "name": "drawnout-digital",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "dev": "cross-env ASTRO_TELEMETRY_DISABLED=1 astro dev --ignore-lock --host 0.0.0.0",
    "check": "cross-env ASTRO_TELEMETRY_DISABLED=1 astro check",
    "build": "cross-env ASTRO_TELEMETRY_DISABLED=1 astro build",
    "preview": "cross-env ASTRO_TELEMETRY_DISABLED=1 astro preview --host 0.0.0.0",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:browser": "playwright test",
    "test:build": "node --test tests/build-output.test.mjs",
    "test:publication": "node --test tests/publication-workflow.test.mjs",
    "verify": "npm run check && npm run lint && npm test && npm run build"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "5.3.0",
    "@tailwindcss/vite": "4.3.3",
    "astro": "7.4.1",
    "gsap": "3.15.0",
    "tailwindcss": "4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.11",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@types/node": "^24.19.2",
    "cross-env": "10.1.0",
    "eslint": "10.13.0",
    "eslint-plugin-astro": "3.2.1",
    "prettier": "3.9.10",
    "prettier-plugin-astro": "1.1.1",
    "tsx": "4.23.15",
    "typescript": "~5.9.3",
    "typescript-eslint": "8.72.0"
  }
}
