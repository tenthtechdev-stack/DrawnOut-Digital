---
import Button from './Button.astro';
---

<section class="fit" data-fit aria-labelledby="fit-title">
  <div class="page-frame fit-inner">
    <div>
      <p class="eyebrow">06 / Good company</p>
      <h2 id="fit-title" class="section-heading" data-motion-text="heading">
        Built for brands <br />
        <span>going somewhere.</span>
      </h2>
    </div>
    <div class="fit-copy">
      <p class="fit-lead" data-motion-support>
        You bring the ambition.
        <br />
        We bring the questions, the thinking,
        <br />
        and the creative execution.
      </p>
      <p>
        Startups building from scratch. Established businesses ready for a new chapter.
        Organizations with something meaningful to communicate. Marketing teams that need a creative
        partner who can see the bigger picture.
      </p>
      <Button href="/contact" variant="text">
        Have Something in Mind?
      </Button>
    </div>
  </div>
</section>
<style>
  .fit {
    border-top: 1px solid var(--line);
    background: var(--surface);
  }
  .fit-inner {
    padding-block: var(--space-6);
    display: grid;
    grid-template-columns: 1.05fr 1fr;
    gap: 80px;
  }
  .eyebrow {
    margin: 0 0 30px;
  }
  h2 span {
    color: var(--accent-strong);
  }
  .fit-copy > p {
    font-size: 15px;
    line-height: 1.8;
    margin: 0 0 30px;
    max-width: 510px;
  }
  .fit-copy .fit-lead {
    font-size: clamp(1.2rem, 1.8vw, 1.6rem);
    letter-spacing: -0.025em;
    line-height: 1.6;
  }
  @media (max-width: 767px) {
    .fit-inner {
      grid-template-columns: 1fr;
      gap: 35px;
    }
    .fit-copy > p {
      font-size: 14px;
    }
  }
</style>
