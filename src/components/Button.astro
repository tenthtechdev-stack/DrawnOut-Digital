---
import Arrow from './Arrow.astro';
interface Props {
  href: string;
  variant?: 'solid' | 'text';
}
const { href, variant = 'solid' } = Astro.props;
---

<a href={href} class:list={['button', `button--${variant}`]}>
  <span>
    <slot />
  </span>
  <Arrow />
</a>
<style>
  .button {
    display: inline-flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-4);
    min-height: 48px;
    padding: 14px 19px;
    font-size: var(--type-small);
    font-weight: 600;
    line-height: 1.4;
    text-decoration: none;
    border: 1px solid transparent;
    border-radius: var(--radius-control);
    transition:
      background-color var(--duration-ui) var(--ease-ui),
      color var(--duration-ui) var(--ease-ui);
  }
  .button :global(svg) {
    width: 18px;
    height: 18px;
    flex-shrink: 0;
    transition: transform 220ms var(--ease-ui);
  }
  .button:is(:hover, :focus-visible) :global(svg) {
    transform: translate(2px, -2px);
  }
  .button--solid {
    background: var(--ink);
    color: var(--cream);
  }
  .button--solid:is(:hover, :focus-visible) {
    background: var(--accent-strong);
  }
  .button--text {
    padding-inline: 0;
    border-radius: 0;
    border-bottom-color: currentColor;
  }
  .button--text:is(:hover, :focus-visible) {
    color: var(--accent-strong);
  }
  :global([data-theme='dark']) .button--solid {
    background: var(--cream);
    color: var(--ink);
  }
  :global([data-theme='dark']) .button--solid:is(:hover, :focus-visible) {
    background: var(--amber);
  }
  :global([data-theme='dark']) .button--text:is(:hover, :focus-visible) {
    color: var(--amber);
  }
  @media (prefers-reduced-motion: reduce) {
    .button,
    .button :global(svg) {
      transition: none;
    }
    .button:is(:hover, :focus-visible) :global(svg) {
      transform: none;
    }
  }
</style>
