---
import type { CollectionEntry } from 'astro:content';
import { getCategoryFilters } from '../../lib/portfolio';
import WorkCard from './WorkCard.astro';
import Button from '../Button.astro';

interface Props {
  projects: CollectionEntry<'projects'>[];
  preview?: boolean;
}
const { projects, preview = false } = Astro.props;
const filters = getCategoryFilters(projects);
const count = projects.length;
---

<section
  id="project-index"
  class="work-index page-frame"
  data-work-index
  data-filter-active="false"
  aria-label="Project index"
>
  {preview && (
    <aside class="work-review-note" aria-label="Private portfolio review">
      <span class="review-indicator" aria-hidden="true"></span>
      <p>
        <strong>Local portfolio preview</strong> · Supplied artwork, unpublished projects.
        Categories describe the imagery; project scope, credits and publication permission await
        confirmation.
      </p>
    </aside>
  )}
  {count > 0 ? (
    <>
      <div class="work-toolbar">
        <div class="work-index-label">
          <p class="eyebrow">01 / The index</p>
          <p class="work-count" role="status" aria-live="polite" data-work-count>
            {count} {count === 1 ? 'project' : 'projects'}
          </p>
        </div>
        {filters.length > 1 && (
          <div class="work-filter-controls" data-work-filters hidden>
            <p class="sr-only" id="work-filter-label">
              Filter projects by artwork category
            </p>
            <div class="work-filter-buttons" role="group" aria-labelledby="work-filter-label">
              {filters.map((filter) => (
                <button
                  type="button"
                  data-filter={filter.id}
                  data-filter-label={filter.label}
                  aria-pressed={filter.id === 'all' ? 'true' : 'false'}
                  aria-controls="work-project-list"
                >
                  {filter.label}
                  <span>{filter.count}</span>
                </button>
              ))}
            </div>
          </div>
        )}
      </div>
      <ul class="work-project-list" id="work-project-list" data-work-project-list>
        {projects.map((project, index) => (
          <WorkCard project={project} index={index} preview={preview} />
        ))}
      </ul>
      <p class="work-filter-empty" data-work-empty hidden>
        There are no projects in this selection. Choose All work to explore the complete index.
      </p>
      <div class="work-closing-note">
        <p class="eyebrow">Ideas with character.</p>
        <p>
          Design with intention.
          <br />
          Stories worth remembering.
        </p>
      </div>
    </>
  ) : (
    <div class="work-unpublished" data-work-unpublished>
      <div class="unpublished-mark" aria-hidden="true">
        <span></span>
        <span></span>
      </div>
      <div>
        <p class="eyebrow">The next chapter</p>
        <h2>
          Good work deserves
          <br />a thoughtful introduction.
        </h2>
        <p>
          Project stories are being prepared. Selected work will appear here after studio approval.
        </p>
        <Button href="/contact" variant="text">
          Have Something in Mind?
        </Button>
      </div>
    </div>
  )}
</section>

<script>
  function initializeWorkFilters() {
    for (const index of document.querySelectorAll<HTMLElement>('[data-work-index]')) {
      if (index.dataset.filtersReady === 'true') continue;
      const controls = index.querySelector<HTMLElement>('[data-work-filters]');
      const cards = [...index.querySelectorAll<HTMLElement>('[data-work-card]')];
      const buttons = [...index.querySelectorAll<HTMLButtonElement>('[data-filter]')];
      const count = index.querySelector<HTMLElement>('[data-work-count]');
      const empty = index.querySelector<HTMLElement>('[data-work-empty]');
      if (!controls || !cards.length || !buttons.length || !count || !empty) continue;
      index.dataset.filtersReady = 'true';
      const allowed = new Map(buttons.map((button) => [button.dataset.filter!, button]));
      const normalize = (value: string | null) => (value && allowed.has(value) ? value : 'all');
      let selected = 'all';
      function applyFilter(category: string, updateHistory: boolean) {
        selected = category;
        let visibleCount = 0;
        for (const card of cards) {
          const matches =
            category === 'all' || (card.dataset.categories ?? '').split(' ').includes(category);
          card.hidden = !matches;
          if (matches) visibleCount += 1;
        }
        for (const button of buttons)
          button.setAttribute('aria-pressed', String(button.dataset.filter === category));
        index.dataset.filterActive = String(category !== 'all');
        const label = allowed.get(category)?.dataset.filterLabel ?? 'All work';
        count!.textContent =
          category === 'all'
            ? `${visibleCount} ${visibleCount === 1 ? 'project' : 'projects'}`
            : `${visibleCount} of ${cards.length} projects · ${label}`;
        empty!.hidden = visibleCount !== 0;
        index.dispatchEvent(new CustomEvent('portfolio:filterchange', { bubbles: true }));
        if (updateHistory) {
          const url = new URL(window.location.href);
          if (category === 'all') url.searchParams.delete('category');
          else url.searchParams.set('category', category);
          window.history.pushState(null, '', url);
        }
      }
      applyFilter(normalize(new URL(window.location.href).searchParams.get('category')), false);
      controls.hidden = false;
      for (const button of buttons)
        button.addEventListener('click', () => {
          const category = normalize(button.dataset.filter ?? null);
          if (category !== selected) applyFilter(category, true);
        });
      window.addEventListener('popstate', () =>
        applyFilter(normalize(new URL(window.location.href).searchParams.get('category')), false),
      );
    }
  }
  initializeWorkFilters();
  document.addEventListener('astro:page-load', initializeWorkFilters);
</script>

<style>
  .work-index {
    padding-bottom: var(--space-7);
  }
  .work-review-note {
    display: flex;
    align-items: baseline;
    gap: 10px;
    padding-block: 20px;
    border-block: 1px solid var(--line);
    margin-bottom: 40px;
  }
  .review-indicator {
    display: block;
    flex-shrink: 0;
    width: 5px;
    height: 5px;
    background: var(--accent-strong);
    border-radius: 50%;
  }
  .work-review-note p {
    max-width: 810px;
    color: var(--muted);
    font-size: 11px;
    line-height: 1.8;
    margin: 0;
  }
  .work-review-note strong {
    color: var(--ink);
    font-weight: 600;
  }
  .work-toolbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 25px;
    padding-bottom: 34px;
  }
  .work-index-label {
    display: flex;
    align-items: center;
    gap: 30px;
    flex-shrink: 0;
  }
  .work-index-label p {
    margin: 0;
  }
  .work-count {
    color: var(--muted);
    font-size: 11px;
    line-height: 1.5;
  }
  .work-filter-buttons {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 5px;
  }
  .work-filter-buttons button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 9px;
    min-height: 44px;
    padding: 10px 13px;
    font-size: 12px;
    line-height: 1.5;
    cursor: pointer;
    background: transparent;
    border: 1px solid transparent;
    border-radius: 3px;
    transition:
      background-color var(--duration-ui) var(--ease-ui),
      color var(--duration-ui) var(--ease-ui);
  }
  .work-filter-buttons button span {
    font-size: 9px;
    opacity: 0.8;
  }
  .work-filter-buttons button[aria-pressed='true'] {
    color: var(--paper);
    background: var(--ink);
  }
  .work-filter-buttons button:hover:not([aria-pressed='true']) {
    border-color: var(--line);
    background: var(--surface);
  }
  .work-project-list {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    align-items: start;
    gap: clamp(55px, 8vw, 125px) clamp(25px, 5vw, 80px);
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .work-project-list > :global([hidden]) {
    display: none;
  }
  .work-closing-note {
    display: flex;
    align-items: start;
    justify-content: space-between;
    gap: 30px;
    margin-top: var(--space-7);
    padding-top: 28px;
    border-top: 1px solid var(--line);
  }
  .work-closing-note > .eyebrow {
    color: var(--accent-strong);
    margin: 0;
  }
  .work-closing-note > p:last-child {
    font-size: clamp(1.5rem, 3.5vw, 3rem);
    letter-spacing: -0.05em;
    line-height: 1.2;
    margin: 0;
  }
  .work-filter-empty {
    font-size: var(--type-body);
    line-height: var(--leading-body);
    padding-block: 60px;
  }
  .work-unpublished {
    display: grid;
    grid-template-columns: 0.8fr 1.2fr;
    align-items: center;
    gap: 12%;
    padding: var(--space-6);
    background: var(--surface);
  }
  .unpublished-mark {
    position: relative;
    aspect-ratio: 1;
    max-width: 330px;
    width: 100%;
  }
  .unpublished-mark span {
    position: absolute;
    inset: 12%;
    border: 1px solid var(--accent-strong);
  }
  .unpublished-mark span:first-child {
    transform: rotate(-12deg);
  }
  .unpublished-mark span:last-child {
    inset: 22%;
    transform: rotate(12deg);
    background: radial-gradient(ellipse at 60% 70%, #f05a285e, #ff9a6021 65%);
  }
  .work-unpublished .eyebrow {
    color: var(--accent-strong);
    margin: 0 0 20px;
  }
  .work-unpublished h2 {
    font-size: clamp(2rem, 3.6vw, 3.5rem);
    line-height: 1.1;
    font-weight: 500;
    letter-spacing: -0.06em;
    margin: 0;
  }
  .work-unpublished div > p:not(.eyebrow) {
    font-size: 14px;
    line-height: 1.8;
    max-width: 460px;
    margin-block: 25px;
    color: var(--muted);
  }
  @media (max-width: 1023px) {
    .work-toolbar {
      align-items: start;
      flex-direction: column;
      gap: 20px;
    }
    .work-filter-buttons {
      justify-content: flex-start;
    }
    .work-unpublished {
      padding: 35px;
      gap: 8%;
    }
  }
  @media (max-width: 639px) {
    .work-review-note {
      margin-bottom: 30px;
    }
    .work-filter-buttons {
      gap: 4px;
    }
    .work-filter-buttons button {
      padding-inline: 10px;
      font-size: 11px;
    }
    .work-project-list {
      row-gap: 55px;
    }
    .work-closing-note {
      flex-direction: column;
      gap: 25px;
    }
    .work-unpublished {
      grid-template-columns: 1fr;
      padding: 30px 24px;
      gap: 30px;
    }
    .unpublished-mark {
      width: 150px;
    }
  }
</style>
