---
import type { CollectionEntry } from 'astro:content';
import MediaSlot from '../MediaSlot.astro';
import PortfolioMotionToggle from '../PortfolioMotionToggle.astro';
import Arrow from '../Arrow.astro';
import { projectCategoryLabels } from '../../lib/portfolio';
import { canPublish } from '../../lib/project-schema';

interface Props {
  project: CollectionEntry<'projects'>;
  index: number;
  preview?: boolean;
  animated?: boolean;
}
const { project, index, preview = false, animated = false } = Astro.props;
const { data } = project;
const unpublished = !canPublish(data);
const href = `${preview && unpublished ? '/_preview/work' : '/work'}/${data.slug}`;
const landscapeDetail = data.gallery.find((media) => media.src.width / media.src.height > 2.1);
// The supplied letterform detail gives Triarch a landscape editorial opening.
// Its original business-card cover remains the mobile composition.
const featuredDetail =
  data.slug === 'triarch'
    ? data.gallery.find((media) => media.src.src.includes('triarch-letterform-detail'))
    : data.presentation === 'wide'
      ? landscapeDetail
      : undefined;
const poster = featuredDetail?.src ?? data.cover;
const categories = data.categories.map((category) => projectCategoryLabels[category]);
const motion = unpublished ? undefined : data.motion;
const motionId = `work-motion-${data.slug}`;
const titleId = `index-project-${data.slug}`;
---

<li
  class:list={[
    'work-item',
    `work-item--${data.presentation}`,
    index % 2 ? 'work-item--right' : 'work-item--left',
  ]}
  style={`--work-poster-ratio: ${poster.width / poster.height}; --work-mobile-poster-ratio: ${data.cover.width / data.cover.height}`}
  data-project-presentation={animated ? 'animated' : 'static'}
  data-work-card
  data-work-scene
  data-portfolio-card
  data-categories={data.categories.join(' ')}
  data-project-slug={data.slug}
>
  <article
    class="work-composition"
    aria-labelledby={titleId}
    data-project-scene
    data-work-composition
  >
    <a class="work-card-link" href={href} aria-labelledby={titleId}>
      <div class="work-card-caption" data-portfolio-caption>
        <div class="work-card-name">
          <span class="work-number" aria-hidden="true">
            {String(index + 1).padStart(2, '0')}
          </span>
          <h2 id={titleId} data-portfolio-title>
            {data.title}
          </h2>
        </div>
        <div class="work-card-description" data-portfolio-meta>
          <p>{categories.length ? categories.join(' / ') : 'Creative presentation'}</p>
          <span class="work-view">
            {preview && unpublished ? 'Preview project' : 'View project'} <Arrow />
          </span>
        </div>
      </div>
      <div class="work-card-media" data-work-frame>
        <MediaSlot
          motion={motion}
          motionId={motionId}
          poster={poster}
          mobilePoster={featuredDetail ? data.cover : undefined}
          alt={featuredDetail?.alt ?? data.coverAlt}
          aspectRatio={`${poster.width} / ${poster.height}`}
          availability={unpublished ? 'placeholder' : 'approved'}
          priority={index === 0}
          sizes="(max-width: 639px) 94vw, (max-width: 1600px) 97vw, 1540px"
        />
        <span class="work-open" aria-hidden="true">
          <Arrow />
        </span>
      </div>
    </a>
    <div class="work-controls-reservation">
      {motion && <PortfolioMotionToggle id={motionId} title={data.title} />}
    </div>
  </article>
</li>

<script>
  import '../../scripts/portfolio-titles';
</script>

<style>
  .work-item {
    --work-progress: 1;
    --work-scroll-start: 0.4;
    --work-scroll-end: 0.14;
    --work-caption-height: 104px;
    --work-frame-ratio: var(--work-poster-ratio);
    --work-full-width: min(100cqw, calc(78svh * var(--work-frame-ratio)));
    --work-frame-height: calc(var(--work-full-width) / var(--work-frame-ratio));
    --work-scale-start: 0.73;
    --work-inset-start: 9%;
    --work-corner: 94px;
    position: relative;
    min-width: 0;
    height: calc(var(--work-caption-height) + var(--work-frame-height) + 52px);
  }
  .work-item[data-project-presentation='animated'] {
    --work-frame-ratio: 1.77777778;
  }
  .work-item--right {
    --work-inset-start: 27%;
    --work-corner: 130px;
  }
  .work-item--portrait {
    --work-scale-start: 0.78;
    --work-inset-start: 3%;
    --work-corner: 56px;
  }
  .work-item--offset {
    --work-scale-start: 0.8;
    --work-inset-start: 18%;
  }
  .work-composition {
    width: var(--work-full-width);
    margin-left: calc((100cqw - var(--work-full-width)) / 2);
  }
  .work-item[data-work-enhanced] .work-composition {
    width: calc(
      var(--work-full-width) *
        (var(--work-scale-start) + (1 - var(--work-scale-start)) * var(--work-progress))
    );
    margin-left: calc(
      (100cqw - var(--work-full-width)) / 2 + var(--work-inset-start) * (1 - var(--work-progress))
    );
  }
  .work-card-link {
    display: block;
    text-decoration: none;
    border-radius: 6px;
  }
  .work-card-link:focus-visible {
    outline: 3px solid var(--accent-strong);
    outline-offset: 6px;
  }
  .work-card-caption {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    min-height: var(--work-caption-height);
    padding: 12px clamp(0px, 0.8vw, 12px) 22px;
  }
  .work-card-name {
    display: flex;
    align-items: baseline;
    gap: clamp(12px, 1.4vw, 24px);
    min-width: 0;
  }
  .work-number {
    color: var(--accent-strong);
    font-size: 11px;
    flex-shrink: 0;
  }
  h2 {
    font-size: clamp(2rem, 3.5vw, 3.5rem);
    font-weight: 500;
    line-height: 1.07;
    letter-spacing: -0.06em;
    margin: 0;
    text-wrap: balance;
  }
  .work-card-description {
    flex-shrink: 0;
    text-align: right;
  }
  .work-card-description p {
    color: var(--muted);
    font-size: 11px;
    line-height: 1.65;
    margin: 0;
  }
  .work-view {
    display: inline-flex;
    align-items: center;
    gap: 14px;
    min-height: 30px;
    margin-top: 5px;
    font-size: 11px;
    line-height: 1.5;
    white-space: nowrap;
  }
  .work-view :global(svg) {
    width: 14px;
    height: 14px;
    transition: transform var(--duration-ui) var(--ease-ui);
  }
  .work-card-media {
    position: relative;
    height: var(--work-frame-height);
    overflow: hidden;
    border-radius: 20px 20px 32px 20px;
    background: var(--surface);
  }
  .work-item[data-work-enhanced] .work-card-media {
    height: calc(
      var(--work-frame-height) *
        (var(--work-scale-start) + (1 - var(--work-scale-start)) * var(--work-progress))
    );
    border-radius: calc(22px + var(--work-corner) * (1 - var(--work-progress))) 22px
      calc(32px + var(--work-corner) * (1 - var(--work-progress))) 22px;
  }
  .work-item--right[data-work-enhanced] .work-card-media {
    border-radius: 22px calc(22px + var(--work-corner) * (1 - var(--work-progress))) 22px
      calc(32px + var(--work-corner) * (1 - var(--work-progress)));
  }
  .work-card-media :global(.media-slot) {
    width: 100%;
    height: 100%;
    aspect-ratio: auto;
    background: transparent;
  }
  .work-card-media :global(img),
  .work-card-media :global(video) {
    object-fit: contain;
  }
  .work-open {
    position: absolute;
    bottom: 20px;
    right: 20px;
    display: grid;
    place-items: center;
    width: 46px;
    height: 46px;
    color: var(--ink);
    background: var(--paper);
    border: 1px solid #20201e1f;
    border-radius: 50%;
    transition: background-color var(--duration-ui) var(--ease-ui);
  }
  .work-open :global(svg) {
    width: 20px;
    height: 20px;
    transition: transform var(--duration-ui) var(--ease-ui);
  }
  .work-card-link:hover .work-open,
  .work-card-link:focus-visible .work-open {
    background: var(--cream);
  }
  .work-card-link:hover .work-open :global(svg),
  .work-card-link:focus-visible .work-open :global(svg),
  .work-card-link:hover .work-view :global(svg) {
    transform: translate(2px, -2px);
  }
  .work-controls-reservation {
    min-height: 52px;
    padding-inline: 4px;
  }
  @media (max-width: 1023px) {
    .work-item {
      --work-caption-height: 112px;
      --work-full-width: min(100cqw, calc(74svh * var(--work-frame-ratio)));
      --work-scale-start: 0.78;
      --work-inset-start: 3%;
    }
    .work-item--right {
      --work-inset-start: 22%;
    }
    .work-card-caption {
      display: block;
      padding-top: 6px;
    }
    .work-card-description {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 16px;
      margin-top: 12px;
      padding-left: 28px;
      text-align: left;
    }
    .work-view {
      margin-top: 0;
    }
  }
  @media (max-width: 639px) {
    .work-item {
      --work-scroll-start: 0.34;
      --work-scroll-end: 0.13;
      --work-caption-height: 132px;
      --work-frame-ratio: var(--work-mobile-poster-ratio);
      --work-full-width: 100cqw;
      --work-scale-start: 0.82;
      --work-inset-start: 2%;
      --work-corner: 40px;
    }
    .work-item[data-project-presentation='animated'] {
      --work-frame-ratio: 0.8;
    }
    .work-item--right {
      --work-inset-start: 18%;
      --work-corner: 54px;
    }
    .work-card-caption {
      padding-inline: 1px;
      padding-bottom: 16px;
    }
    .work-card-name {
      gap: 12px;
    }
    .work-number {
      font-size: 9px;
    }
    h2 {
      font-size: clamp(1.6rem, 7.1vw, 2.5rem);
      line-height: 1.1;
      letter-spacing: -0.055em;
    }
    .work-card-description {
      align-items: start;
      padding-left: 23px;
      gap: 10px;
      margin-top: 12px;
    }
    .work-card-description p {
      font-size: 10px;
      max-width: 155px;
    }
    .work-view {
      gap: 6px;
      min-height: 26px;
      font-size: 10px;
    }
    .work-view :global(svg) {
      width: 12px;
      height: 12px;
    }
    .work-open {
      bottom: 12px;
      right: 12px;
      width: 36px;
      height: 36px;
    }
    .work-open :global(svg) {
      width: 16px;
      height: 16px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .work-open,
    .work-open :global(svg),
    .work-view :global(svg) {
      transition: none;
      transform: none !important;
    }
  }
</style>
