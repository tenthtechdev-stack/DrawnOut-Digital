---
import Button from './Button.astro';
import SignatureArtwork from './SignatureArtwork.astro';
import { navigation, site } from '../data/site';
import { contact } from '../data/contact';
---

<footer class="site-footer" data-site-footer data-theme="dark">
  <div class="footer-art" data-footer-stage aria-hidden="true">
    <div class="footer-atmosphere" data-footer-atmosphere></div>
    <div class="footer-signature" data-footer-signature>
      <SignatureArtwork variant="footer" />
    </div>
    <div class="footer-scrim"></div>
  </div>
  <div class="page-frame footer-content">
    <p class="eyebrow">Start with a thought.</p>
    <h2>
      Have a good idea?
      <br />
      Let's make it <span>better.</span>
    </h2>
    <p class="footer-intro">
      You don't need a perfect brief.
      <br />
      You just need somewhere to start.
    </p>
    <Button href="/contact">Tell Us What You're Thinking</Button>
    <div class="footer-bottom">
      <div class="footer-brand">
        <a href="/" aria-label="DrawnOut Digital home">
          {site.name}
        </a>
        <p>{site.signoff}</p>
        <a class="footer-email" href={`mailto:${contact.email}`}>
          {contact.email}
        </a>
      </div>
      <nav aria-label="Footer navigation">
        <ul>
          {navigation.map((item) => (
            <li>
              <a href={item.href}>{item.label}</a>
            </li>
          ))}
        </ul>
      </nav>
    </div>
    <div class="footer-legal">
      <span>
        © {new Date().getFullYear()} {site.name}
      </span>
      <span>Independent creative &amp; digital studio</span>
    </div>
  </div>
</footer>
<script>
  import '../scripts/signature-footer';
</script>
<style>
  .site-footer {
    background: #171714;
    color: var(--cream);
    position: relative;
    isolation: isolate;
    overflow: hidden;
  }
  .footer-content {
    position: relative;
    padding-top: clamp(100px, 12vw, 180px);
    z-index: 1;
  }
  .footer-content > .eyebrow {
    color: var(--inverse-muted);
    margin: 0 0 35px;
  }
  h2 {
    font-size: clamp(2.6rem, 6.4vw, 6.25rem);
    font-weight: 500;
    line-height: 1.06;
    letter-spacing: var(--tracking-display);
    margin: 0 0 30px;
    max-width: 980px;
  }
  h2 span {
    color: var(--amber);
  }
  .footer-intro {
    color: var(--inverse-muted);
    font-size: var(--type-small);
    line-height: 1.8;
    margin: 0 0 30px;
  }
  .footer-art {
    position: absolute;
    inset: 0;
    z-index: 0;
    overflow: hidden;
    pointer-events: none;
  }
  .footer-signature {
    position: absolute;
    width: min(57%, 830px);
    right: -3%;
    top: -20%;
    transform-origin: 65% 48%;
  }
  .footer-atmosphere {
    position: absolute;
    inset: -20%;
    background:
      radial-gradient(ellipse at 84% 45%, #9b370a55, transparent 52%),
      radial-gradient(ellipse at 62% 90%, #6e351530, transparent 60%);
  }
  .footer-scrim {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(90deg, #171714f5 0%, #171714e0 22%, #17171475 53%, #17171420 80%),
      linear-gradient(0deg, #171714 0%, #171714bb 16%, transparent 58%);
  }
  .footer-bottom {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 40px;
    margin-top: clamp(120px, 15vw, 220px);
    padding-bottom: 35px;
  }
  .footer-brand > a {
    font-size: 25px;
    line-height: 1.3;
    font-weight: 650;
    letter-spacing: -0.055em;
    text-decoration: none;
  }
  .footer-brand p {
    color: var(--inverse-muted);
    font-size: 12px;
    line-height: 1.8;
    margin: 12px 0 0;
  }
  ul {
    display: flex;
    flex-wrap: wrap;
    list-style: none;
    padding: 0;
    margin: 0;
    gap: 12px 25px;
  }
  .footer-brand > .footer-email {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-size: 13px;
    font-weight: 400;
    letter-spacing: 0;
    overflow-wrap: anywhere;
  }
  .footer-email:is(:hover, :focus-visible) {
    color: var(--amber);
    text-decoration: underline;
  }
  nav a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-size: 13px;
    text-decoration: none;
  }
  nav a:hover {
    color: var(--amber);
    text-decoration: underline;
  }
  .footer-legal {
    display: flex;
    justify-content: space-between;
    gap: 20px;
    padding-block: 25px;
    border-top: 1px solid #ffffff30;
    color: var(--inverse-muted);
    font-size: 11px;
    line-height: 1.8;
  }
  @media (max-width: 767px) {
    .footer-bottom {
      flex-direction: column;
      align-items: start;
      gap: 28px;
      margin-top: 70px;
    }
    .footer-art {
      inset: 0;
    }
    .footer-signature {
      top: -3%;
      right: -40%;
      width: 112%;
    }
    .footer-scrim {
      background:
        linear-gradient(90deg, #171714e6 0%, #171714b3 32%, #17171452 82%),
        linear-gradient(0deg, #171714 0%, #171714d6 28%, transparent 76%);
    }
    .footer-content {
      padding-top: 110px;
    }
    .footer-legal {
      flex-direction: column;
      gap: 7px;
    }
    h2 {
      font-size: clamp(2.2rem, 8.5vw, 4rem);
    }
  }
</style>
