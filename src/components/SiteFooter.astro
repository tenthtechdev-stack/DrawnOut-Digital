---
import Button from './Button.astro';
import { navigation, site } from '../data/site';
---

<footer class="site-footer" data-site-footer data-theme="dark">
  <div class="footer-art" data-footer-stage aria-hidden="true">
    <div class="glass-frame"></div>
    <div class="frame-edge"></div>
  </div>
  <div class="page-frame footer-content">
    <p class="eyebrow">Start with a thought.</p>
    <h2>
      Have a good idea?
      <br />
      Let's make it <span>better.</span>
    </h2>
    <p class="footer-intro">
      You don't need a perfect brief.
      <br />
      You just need somewhere to start.
    </p>
    <Button href="/contact">Tell Us What You're Thinking</Button>
    <div class="footer-bottom">
      <div class="footer-brand">
        <a href="/" aria-label="DrawnOut Digital home">
          {site.name}
        </a>
        <p>{site.signoff}</p>
      </div>
      <nav aria-label="Footer navigation">
        <ul>
          {navigation.map((item) => (
            <li>
              <a href={item.href}>{item.label}</a>
            </li>
          ))}
        </ul>
      </nav>
    </div>
    <div class="footer-legal">
      <span>
        © {new Date().getFullYear()} {site.name}
      </span>
      <span>Independent creative &amp; digital studio</span>
    </div>
  </div>
</footer>
<style>
  .site-footer {
    background: #252522;
    color: var(--cream);
    position: relative;
    isolation: isolate;
    overflow: hidden;
  }
  .footer-content {
    position: relative;
    padding-top: var(--space-6);
  }
  .footer-content > .eyebrow {
    color: var(--inverse-muted);
    margin: 0 0 35px;
  }
  h2 {
    font-size: clamp(2.6rem, 6.4vw, 6.25rem);
    font-weight: 500;
    line-height: 1.06;
    letter-spacing: var(--tracking-display);
    margin: 0 0 30px;
    max-width: 980px;
  }
  h2 span {
    color: var(--amber);
  }
  .footer-intro {
    color: var(--inverse-muted);
    font-size: var(--type-small);
    line-height: 1.8;
    margin: 0 0 30px;
  }
  .footer-art {
    position: absolute;
    inset: 0 0 auto auto;
    width: 47%;
    height: 80%;
    z-index: -1;
    overflow: hidden;
    background: radial-gradient(ellipse at 91% 48%, #8a3f2a66, transparent 65%);
    pointer-events: none;
  }
  .glass-frame {
    position: absolute;
    right: -12%;
    top: 18%;
    width: 66%;
    aspect-ratio: 1;
    transform: rotate(-17deg);
    border-radius: 20px;
    border: 1px solid #ffb47b4a;
    box-shadow:
      inset 1px 1px 1px #fff6db1a,
      0 0 65px #ff8f3a0d;
  }
  .frame-edge {
    position: absolute;
    right: -9%;
    top: 20%;
    width: 66%;
    aspect-ratio: 1;
    transform: rotate(-17deg);
    border: 1px solid #ffb47b1f;
    border-radius: 20px;
  }
  .footer-bottom {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 40px;
    margin-top: var(--space-7);
    padding-bottom: 35px;
  }
  .footer-brand > a {
    font-size: 25px;
    line-height: 1.3;
    font-weight: 650;
    letter-spacing: -0.055em;
    text-decoration: none;
  }
  .footer-brand p {
    color: var(--inverse-muted);
    font-size: 12px;
    line-height: 1.8;
    margin: 12px 0 0;
  }
  ul {
    display: flex;
    flex-wrap: wrap;
    list-style: none;
    padding: 0;
    margin: 0;
    gap: 12px 25px;
  }
  nav a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-size: 13px;
    text-decoration: none;
  }
  nav a:hover {
    color: var(--amber);
    text-decoration: underline;
  }
  .footer-legal {
    display: flex;
    justify-content: space-between;
    gap: 20px;
    padding-block: 25px;
    border-top: 1px solid #ffffff30;
    color: var(--inverse-muted);
    font-size: 11px;
    line-height: 1.8;
  }
  @media (max-width: 767px) {
    .footer-bottom {
      flex-direction: column;
      align-items: start;
      gap: 28px;
      margin-top: 70px;
    }
    .footer-art {
      width: 70%;
      height: 55%;
    }
    .glass-frame,
    .frame-edge {
      top: 30%;
      right: -55%;
      width: 100%;
    }
    .footer-legal {
      flex-direction: column;
      gap: 7px;
    }
    h2 {
      font-size: clamp(2.2rem, 8.5vw, 4rem);
    }
  }
</style>
