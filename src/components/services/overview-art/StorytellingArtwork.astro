---
const lines = Array.from({ length: 8 }, (_, index) => index);
---

<svg
  viewBox="0 0 720 620"
  width="720"
  height="620"
  fill="none"
  aria-hidden="true"
  focusable="false"
>
  <defs>
    <linearGradient
      id="overview-story-paper"
      x1="50"
      y1="0"
      x2="650"
      y2="0"
      gradientUnits="userSpaceOnUse"
    >
      <stop stop-color="#fffaf0" />
      <stop offset=".48" stop-color="#f6f0e4" />
      <stop offset=".5" stop-color="#d8d0bd" />
      <stop offset=".52" stop-color="#f5efe3" />
      <stop offset="1" stop-color="#fffaf0" />
    </linearGradient>
    <filter id="overview-story-shadow" x="-20%" y="-20%" width="150%" height="160%">
      <feDropShadow dx="0" dy="16" stdDeviation="13" flood-color="#473f30" flood-opacity=".15" />
    </filter>
  </defs>
  <rect width="720" height="620" rx="3" fill="#ded5c5" />
  <g transform="rotate(-5 348 277)" filter="url(#overview-story-shadow)">
    <path
      d="M38 73Q194 54 350 76Q506 54 662 73V465Q506 448 350 471Q194 448 38 465Z"
      fill="url(#overview-story-paper)"
    />
    <path d="M350 77V470" stroke="#c8bfae" opacity=".6" />
    <text x="61" y="109" font-size="8" letter-spacing="2" fill="#665d4d">
      A THOUGHT, TAKING SHAPE.
    </text>
    <text x="59" y="225" font-family="Georgia,serif" font-size="138" fill="#f05a28">
      “
    </text>
    <text x="71" y="251" font-size="41" font-weight="500" letter-spacing="-2" fill="#20201e">
      Think it
    </text>
    <text x="71" y="299" font-size="41" font-weight="500" letter-spacing="-2" fill="#20201e">
      through.
    </text>
    <path
      d="M71 316C134 300 219 332 287 308"
      stroke="#c34723"
      stroke-width="2.3"
      stroke-linecap="round"
    />
    <text x="72" y="354" font-size="10" letter-spacing="1.8" fill="#786c5b">
      VOICE / INTENT / MEANING
    </text>
    {lines.slice(0, 5).map((line) => (
      <path
        d={`M72 ${376 + line * 9}H${line === 4 ? 245 : 298}`}
        stroke="#c6bdad"
        stroke-width="1.3"
      />
    ))}
    <text x="379" y="109" font-size="8" letter-spacing="2" fill="#665d4d">
      THE EDIT / 04
    </text>
    <text x="378" y="169" font-size="30" font-weight="500" letter-spacing="-1.2" fill="#20201e">
      Draw it out.
    </text>
    {lines.map((line) => (
      <path
        d={`M380 ${198 + line * 12}H${line % 3 === 2 ? 592 : 629}`}
        stroke="#b6ac99"
        stroke-width="1.5"
      />
    ))}
    <path
      d="M375 222H581M375 227H581M615 249 624 259 642 236"
      stroke="#c34723"
      stroke-width="1.7"
      stroke-linecap="round"
    />
    <path d="M368 190H359V288H368" stroke="#c34723" stroke-width="1.5" />
    <text
      x="379"
      y="345"
      font-family="Georgia,serif"
      font-size="37"
      font-style="italic"
      fill="#b24122"
    >
      Make it matter.
    </text>
    <path d="M380 363C446 373 536 355 630 365" stroke="#c34723" stroke-width="1.5" />
    <text x="379" y="423" font-size="8" letter-spacing="1.7" fill="#665d4d">
      LESS NOISE. A CLEARER IDEA.
    </text>
  </g>
  <g transform="rotate(4 500 485)" filter="url(#overview-story-shadow)">
    <rect x="281" y="414" width="399" height="156" fill="#292a25" />
    <text x="304" y="443" font-size="8" letter-spacing="2" fill="#c2b9a7">
      THE THOUGHT, RESOLVED.
    </text>
    <text x="302" y="493" font-size="37" font-weight="500" letter-spacing="-2" fill="#fff8ee">
      Words that
    </text>
    <text x="302" y="536" font-size="37" font-weight="500" letter-spacing="-2" fill="#fff8ee">
      mean something.
    </text>
    <path
      d="M597 450C634 446 643 466 630 484S594 500 613 520"
      stroke="#f05a28"
      stroke-width="3"
      stroke-linecap="round"
    />
  </g>
  <text x="30" y="592" font-size="8" letter-spacing="2" fill="#675d4c">
    EDITORIAL / TONE OF VOICE / MESSAGING
  </text>
</svg>
