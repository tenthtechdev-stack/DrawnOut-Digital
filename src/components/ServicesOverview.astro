---
import { capabilities } from '../data/site';
import Arrow from './Arrow.astro';
---

<section class="services page-frame" data-services aria-labelledby="services-title">
  <div class="services-intro">
    <p class="eyebrow">03 / Connected thinking</p>
    <h2 class="section-heading" id="services-title">
      We think beyond <br />
      <span>the brief.</span>
    </h2>
    <p class="services-note">A bigger idea needs a bigger picture.</p>
  </div>
  <ol>
    {capabilities.map((capability, index) => (
      <li>
        <a href={`/services#${capability.id}`}>
          <span class="service-number">0{index + 1}</span>
          <div>
            <h3>{capability.title}</h3>
            <p>{capability.proposition}</p>
          </div>
          <Arrow />
        </a>
      </li>
    ))}
  </ol>
</section>
<style>
  .services {
    display: grid;
    grid-template-columns: 0.8fr 1.2fr;
    gap: clamp(40px, 7vw, 110px);
    padding-block: var(--space-7);
  }
  .services-intro > .eyebrow {
    margin: 0 0 35px;
  }
  h2 span {
    color: var(--accent-strong);
  }
  .services-note {
    max-width: 240px;
    margin: 30px 0 0;
    color: var(--muted);
    font-size: var(--type-small);
    line-height: 1.8;
  }
  ol {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  li {
    border-top: 1px solid var(--line);
  }
  li:last-child {
    border-bottom: 1px solid var(--line);
  }
  a {
    display: grid;
    grid-template-columns: 25px 1fr 22px;
    gap: 20px;
    padding-block: 29px;
    text-decoration: none;
  }
  .service-number {
    font-size: 10px;
    line-height: 2;
    color: var(--muted);
  }
  h3 {
    font-size: clamp(1.2rem, 1.8vw, 1.7rem);
    font-weight: 500;
    line-height: 1.3;
    letter-spacing: -0.035em;
    margin: 0;
  }
  li p {
    font-size: 13px;
    line-height: 1.8;
    color: var(--muted);
    margin: 12px 0 0;
    max-width: 400px;
  }
  a :global(svg) {
    width: 20px;
    height: 20px;
    margin-top: 3px;
  }
  a:hover h3,
  a:hover :global(svg) {
    color: var(--accent-strong);
  }
  @media (max-width: 767px) {
    .services {
      grid-template-columns: 1fr;
      gap: 40px;
    }
    a {
      gap: 12px;
      grid-template-columns: 20px 1fr 20px;
    }
  }
</style>
