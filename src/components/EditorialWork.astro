---
import { getPublicProjects } from '../lib/projects';
import ProjectCard from './ProjectCard.astro';
import Button from './Button.astro';
const records = await getPublicProjects({ featuredOnly: true });
const [opening, community, architecture, dessert, technology, ...additional] = records;
---

<div class="editorial-work" data-editorial-work data-portfolio-rhythm>
  <p class="review-caption">
    <span class="review-dot" aria-hidden="true"></span> Selected projects · a closer look
  </p>
  {opening && (
    <div class="work-scene work-scene--opening" data-expansion-frame data-motion-immersive>
      <ProjectCard project={opening} index={0} layout="panorama" media={opening.data.gallery[0]} />
    </div>
  )}
  <div class="editorial-pair" data-portfolio-pair>
    {community && (
      <div class="work-scene work-scene--community" data-expansion-frame>
        <ProjectCard project={community} index={1} />
      </div>
    )}
    {architecture && (
      <div class="work-scene work-scene--architecture" data-expansion-frame>
        <ProjectCard project={architecture} index={2} />
      </div>
    )}
  </div>
  <div class="work-interlude">
    <p data-motion-text="scrub">
      Every project starts <br />
      with a <span>question.</span>
    </p>
    <span class="eyebrow">
      Every outcome
      <br />
      has a reason.
    </span>
  </div>
  {dessert && (
    <div class="work-scene work-scene--dessert" data-expansion-frame>
      <ProjectCard project={dessert} index={3} layout="panorama" media={dessert.data.gallery[0]} />
    </div>
  )}
  {technology && (
    <div class="work-scene work-scene--technology" data-expansion-frame>
      <ProjectCard project={technology} index={4} layout="lead" />
    </div>
  )}
  {additional.map((project, index) => (
    <div class="work-scene work-scene--technology" data-expansion-frame>
      <ProjectCard project={project} index={index + 5} layout="panorama" />
    </div>
  ))}
  <div class="work-outro">
    <p>Explore the details, the compositions and the ideas in view.</p>
    <Button href="/work" variant="text">
      Explore Selected Work
    </Button>
  </div>
</div>
<style>
  .review-caption {
    display: flex;
    align-items: center;
    gap: 9px;
    font-size: 11px;
    line-height: 1.7;
    color: var(--muted);
    margin: 0 0 28px;
  }
  .review-dot {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--accent-strong);
    flex-shrink: 0;
  }
  .work-scene {
    min-width: 0;
  }
  /* The image owns its final near-viewport geometry before JS. Scroll animates
     only the mask and inner picture, leaving captions and document flow stable. */
  [data-motion-immersive] :global(.media-slot) {
    --immersive-gutter: clamp(8px, 1.2vw, 24px);
    width: calc(100vw - 2 * var(--immersive-gutter));
    max-width: none;
    margin-inline: calc((100% - 100vw) / 2 + var(--immersive-gutter));
  }
  .editorial-pair {
    display: grid;
    grid-template-columns: 1.2fr 0.8fr;
    gap: clamp(35px, 8vw, 125px);
    margin-top: var(--space-6);
    align-items: start;
  }
  .work-scene--architecture {
    margin-top: 135px;
  }
  .work-scene--architecture :global(.project-meta) {
    display: block;
  }
  .work-scene--architecture :global(.project-context) {
    text-align: left;
    margin-top: 15px;
  }
  .work-interlude {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 30px;
    padding-block: var(--space-7);
  }
  .work-interlude > p {
    margin: 0;
    font-size: clamp(2.5rem, 5vw, 5.5rem);
    font-weight: 500;
    letter-spacing: -0.06em;
    line-height: 1.08;
  }
  .work-interlude > p span {
    color: var(--accent-strong);
  }
  .work-interlude > .eyebrow {
    color: var(--muted);
    margin-bottom: 8px;
    line-height: 1.8;
  }
  .work-scene--technology {
    margin-top: var(--space-6);
  }
  .work-outro {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 40px;
    margin-top: 35px;
  }
  .work-outro > p {
    max-width: 510px;
    font-size: 11px;
    color: var(--muted);
    line-height: 1.8;
    margin: 0;
  }
  @media (max-width: 767px) {
    .editorial-pair {
      grid-template-columns: 1fr;
      gap: 45px;
    }
    .work-scene--architecture {
      width: 85%;
      max-width: 85%;
      margin: 0 0 0 auto;
    }
    .work-scene--architecture :global(.project-meta) {
      display: flex;
    }
    .work-scene--architecture :global(.project-context) {
      text-align: right;
      margin-top: 0;
    }
    .work-interlude {
      align-items: start;
      flex-direction: column;
      gap: 25px;
      padding-block: 60px;
    }
    .work-interlude > p {
      font-size: clamp(2rem, 8.3vw, 3.5rem);
    }
    .work-outro {
      align-items: start;
      flex-direction: column;
      gap: 25px;
    }
  }
</style>
