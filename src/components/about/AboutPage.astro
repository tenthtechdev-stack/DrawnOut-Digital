---
import Arrow from '../Arrow.astro';
import Button from '../Button.astro';
import FounderPortrait from './FounderPortrait.astro';
import { aboutPage } from '../../data/about';
import '../../styles/about.css';

const { hero, origin, founders, philosophy, approach, audience, invitation } = aboutPage;
const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'AboutPage',
  name: aboutPage.metadata.title,
  description: aboutPage.metadata.description,
  about: { '@type': 'Organization', name: 'DrawnOut Digital' },
};
---

<article class="about-page" data-about-page>
  <section class="about-hero page-frame" aria-labelledby="about-title" data-about-hero>
    <header class="about-hero__heading">
      <p class="eyebrow about-eyebrow" data-about-reveal>
        {hero.eyebrow}
      </p>
      <h1 id="about-title" aria-label={hero.heading}>
        {hero.headlineSegments.map((segment) => (
          <span class="about-title-mask">
            <span data-about-headline>{segment} </span>
          </span>
        ))}
      </h1>
    </header>

    <svg class="about-hero__thread" viewBox="0 0 360 160" fill="none" aria-hidden="true">
      <path
        data-about-hero-line
        d="M2 98C70 98 62 28 137 28S179 139 247 139 270 10 356 10"
        pathLength="1"
      />
    </svg>

    <figure class="about-hero__portrait" data-about-portrait>
      <FounderPortrait />
      <figcaption data-about-caption>
        <span>{hero.caption}</span>
        <span class="about-figure-index" aria-hidden="true">
          01 / TWO MINDS
        </span>
      </figcaption>
    </figure>

    <div class="about-hero__intro" data-about-intro>
      {hero.paragraphs.map((paragraph) => (
        <p>{paragraph}</p>
      ))}
    </div>
    <div class="about-hero__signoff" data-about-reveal>
      <p>{hero.supportingLabel}</p>
      <a href="#our-beginning" class="about-story-link">
        Follow the thought <span aria-hidden="true">↓</span>
      </a>
    </div>
  </section>

  <section
    class="about-origin about-chapter"
    id="our-beginning"
    aria-labelledby="about-origin-title"
    data-about-origin
  >
    <div class="page-frame">
      <div class="about-editorial-grid">
        <header>
          <p class="eyebrow about-eyebrow">{origin.eyebrow}</p>
          <h2 class="about-heading" id="about-origin-title" data-about-reveal>
            {origin.heading}
          </h2>
        </header>
        <div class="about-copy" data-about-reveal>
          {origin.paragraphs.map((paragraph) => (
            <p>{paragraph}</p>
          ))}
        </div>
      </div>

      <div class="about-origin__story" data-about-story>
        <svg
          class="about-origin__line about-origin__line--wide"
          viewBox="0 0 1200 140"
          fill="none"
          preserveAspectRatio="none"
          aria-hidden="true"
        >
          <path
            class="about-line-base"
            d="M4 74C165 74 132 18 268 27S435 111 587 75 759 14 889 44 1062 96 1196 63"
          />
          <path
            data-about-story-line
            data-about-draw
            d="M4 74C165 74 132 18 268 27S435 111 587 75 759 14 889 44 1062 96 1196 63"
            pathLength="1"
          />
        </svg>
        <svg
          class="about-origin__line about-origin__line--narrow"
          viewBox="0 0 50 300"
          fill="none"
          preserveAspectRatio="none"
          aria-hidden="true"
        >
          <path class="about-line-base" d="M20 3C-8 59 60 71 24 139S4 226 23 298" />
          <path
            data-about-story-line
            data-about-draw
            d="M20 3C-8 59 60 71 24 139S4 226 23 298"
            pathLength="1"
          />
        </svg>
        <ol class="about-origin__markers">
          {origin.markers.map((marker, index) => (
            <li data-about-story-marker>
              <span class="about-origin__dot" aria-hidden="true" />
              <span class="about-origin__marker-number" aria-hidden="true">
                0{index + 1}
              </span>
              <span>{marker}</span>
            </li>
          ))}
        </ol>
      </div>
    </div>
  </section>

  <section
    class="about-founders about-chapter page-frame"
    aria-labelledby="about-founders-title"
    data-about-founders
  >
    <header class="about-chapter-heading">
      <p class="eyebrow about-eyebrow">{founders.eyebrow}</p>
      <h2 class="about-heading" id="about-founders-title" data-about-reveal>
        {founders.heading}
      </h2>
    </header>
    <div class="about-founders__profiles">
      <svg class="about-founders__connection" viewBox="0 0 240 100" fill="none" aria-hidden="true">
        <path
          data-about-founder-line
          data-about-draw
          d="M2 61C72 61 64 17 120 17S168 82 238 58"
          pathLength="1"
        />
      </svg>
      {founders.profiles.map((founder) => (
        <section
          class="about-founder"
          aria-labelledby={`founder-${founder.name.toLowerCase()}`}
          data-about-founder
        >
          <p class="eyebrow about-founder__role">{founder.role}</p>
          <h3 id={`founder-${founder.name.toLowerCase()}`} class="about-founder__name">
            <span data-about-founder-name>{founder.name}</span>
          </h3>
          <p class="about-founder__experience">{founder.experience}</p>
          <p class="about-founder__description" data-about-reveal>
            {founder.description}
          </p>
        </section>
      ))}
    </div>
    <p class="about-founders__signoff" data-about-reveal>
      {founders.signoff}
    </p>
  </section>

  <section
    class="about-philosophy about-chapter"
    aria-labelledby="about-philosophy-title"
    data-about-philosophy
    data-theme="dark"
  >
    <div class="page-frame">
      <div class="about-editorial-grid">
        <header>
          <p class="eyebrow about-eyebrow">{philosophy.eyebrow}</p>
          <h2 class="about-heading" id="about-philosophy-title" data-about-reveal>
            {philosophy.heading}
          </h2>
        </header>
        <p class="about-philosophy__intro" data-about-reveal>
          {philosophy.intro}
        </p>
      </div>
      <ol class="about-principles">
        {philosophy.principles.map((principle) => (
          <li data-about-principle>
            <span class="about-principle__number" aria-hidden="true">
              {principle.number}
            </span>
            <h3 data-about-reveal>{principle.heading}</h3>
            <p data-about-reveal>{principle.description}</p>
            <span class="about-principle__rule" data-about-principle-rule aria-hidden="true" />
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section
    class="about-approach about-chapter page-frame"
    aria-labelledby="about-approach-title"
    data-about-process
  >
    <header class="about-chapter-heading">
      <p class="eyebrow about-eyebrow">{approach.eyebrow}</p>
      <h2 class="about-heading" id="about-approach-title" data-about-reveal>
        {approach.heading}
      </h2>
    </header>

    <div class="about-process" data-about-process-system>
      <div class="about-process__graphic" aria-hidden="true">
        <svg viewBox="0 0 1200 210" fill="none" preserveAspectRatio="xMidYMid meet">
          <path class="about-process__connector" d="M145 105H1045" />
          <path data-about-process-line data-about-draw d="M145 105H1045" pathLength="1" />
          <g class="about-process__shape" data-about-process-shape="thought">
            <circle cx="145" cy="105" r="76" class="about-process__paper" />
            <path d="M92 114C73 56 199 47 174 107S97 147 121 96 208 97 196 119" />
          </g>
          <g class="about-process__shape" data-about-process-shape="direction">
            <circle cx="445" cy="105" r="76" class="about-process__paper" />
            <path d="M390 143 498 66M451 69 498 66 483 112" />
          </g>
          <g class="about-process__shape" data-about-process-shape="form">
            <circle cx="745" cy="105" r="76" class="about-process__paper" />
            <path d="M695 148V62H785V148H695Z" />
            <path class="about-process__fine" d="M695 62 785 148M785 62 695 148" />
          </g>
          <g class="about-process__shape" data-about-process-shape="connection">
            <circle cx="1045" cy="105" r="76" class="about-process__paper" />
            <path d="M1002 147V63H1086V147H1002Z" />
            <circle cx="1044" cy="105" r="60" />
            <path class="about-process__fine" d="M1002 105H1086M1044 63V147" />
          </g>
        </svg>
      </div>
      <ol class="about-process__phases">
        {approach.phases.map((phase) => (
          <li data-about-process-phase data-about-phase={phase.concept.toLowerCase()}>
            <svg
              class="about-process__mobile-shape"
              data-about-process-shape-mobile={phase.concept.toLowerCase()}
              viewBox="0 0 120 120"
              fill="none"
              aria-hidden="true"
            >
              <circle class="about-process__paper" cx="60" cy="60" r="59" />
              {phase.concept === 'Thought' && (
                <path d="M21 68C9 20 105 16 84 67S27 99 43 53 109 56 100 76" />
              )}
              {phase.concept === 'Direction' && <path d="M21 88 99 31M64 33 99 31 88 65" />}
              {phase.concept === 'Form' && (
                <>
                  <path d="M27 93V27H93V93H27Z" />
                  <path class="about-process__fine" d="M27 27 93 93M93 27 27 93" />
                </>
              )}
              {phase.concept === 'Connection' && (
                <>
                  <path d="M30 90V30H90V90H30Z" />
                  <circle cx="60" cy="60" r="44" />
                  <path class="about-process__fine" d="M30 60H90M60 30V90" />
                </>
              )}
            </svg>
            <p class="about-process__concept">
              <span aria-hidden="true">{phase.number} / </span>
              {phase.concept}
            </p>
            <h3 data-about-reveal>{phase.heading}</h3>
            <p class="about-process__description" data-about-reveal>
              {phase.description}
            </p>
          </li>
        ))}
      </ol>
    </div>
    <a href="/services" class="about-text-link">
      Explore our services <Arrow />
    </a>
  </section>

  <section
    class="about-audience about-chapter"
    aria-labelledby="about-audience-title"
    data-about-audience
  >
    <div class="page-frame">
      <p class="eyebrow about-eyebrow">{audience.eyebrow}</p>
      <h2 class="about-audience__heading" id="about-audience-title" data-about-reveal>
        {audience.heading}
      </h2>
      <div class="about-audience__lower">
        <svg class="about-audience__thought" viewBox="0 0 320 200" fill="none" aria-hidden="true">
          <path
            data-about-draw
            d="M8 175C96 175 72 25 175 25 247 25 198 137 153 118S169 5 224 32 220 132 310 132"
            pathLength="1"
          />
        </svg>
        <div class="about-copy" data-about-reveal>
          {audience.paragraphs.map((paragraph) => (
            <p>{paragraph}</p>
          ))}
          <a href="/work" class="about-text-link">
            See the ideas we've shaped <Arrow />
          </a>
        </div>
      </div>
    </div>
  </section>

  <section
    class="about-invitation about-chapter page-frame"
    aria-labelledby="about-invitation-title"
    data-about-invitation
  >
    <p class="eyebrow about-eyebrow">{invitation.eyebrow}</p>
    <div class="about-invitation__layout">
      <h2 class="about-heading" id="about-invitation-title" data-about-reveal>
        {invitation.heading}
      </h2>
      <div class="about-invitation__action" data-about-reveal>
        <svg
          class="about-invitation__flourish"
          viewBox="0 0 180 100"
          fill="none"
          aria-hidden="true"
        >
          <path
            data-about-draw
            d="M3 61C51 61 50 12 95 12S140 90 95 90 74 12 124 12C148 12 160 31 171 42M149 42H171V20"
            pathLength="1"
          />
        </svg>
        <p>{invitation.supportingCopy}</p>
        <Button href={invitation.cta.href}>{invitation.cta.label}</Button>
      </div>
    </div>
    <p class="about-invitation__concept">{aboutPage.concept}</p>
  </section>
</article>
<script
  type="application/ld+json"
  set:html={JSON.stringify(structuredData).replace(/</g, '\\u003c')}
/>
