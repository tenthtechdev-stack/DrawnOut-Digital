---
import PremiumAboutHero from './PremiumAboutHero.astro';
import AboutEditorial from './AboutEditorial.astro';
import { aboutPage } from '../../data/about';

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'AboutPage',
  name: aboutPage.metadata.title,
  description: aboutPage.metadata.description,
  about: { '@type': 'Organization', name: 'DrawnOut Digital' },
};
---

<article class="about-page" data-about-page>
  <PremiumAboutHero />
  <AboutEditorial />
</article>
<script>
  import '../../scripts/about-motion';
</script>
<script
  type="application/ld+json"
  set:html={JSON.stringify(structuredData).replace(/</g, '\\u003c')}
/>
