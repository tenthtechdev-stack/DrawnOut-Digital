---
import { Image } from 'astro:assets';
import { aboutPage } from '../../data/about';
import plaque from '../../assets/signature/emblem-plaque.png';
import FounderPortrait from './FounderPortrait.astro';
import '../../styles/about-premium-hero.css';

const { hero } = aboutPage;
const headline = ['Two twins.', 'One idea.', 'A whole lot', 'of creativity.'];
---

<section
  class="premium-about-hero"
  aria-labelledby="about-title"
  data-about-hero
  data-theme="dark"
  data-about-hero-phase="settled"
  data-about-emblem-status="approved-raster-prototype"
>
  <div class="premium-about-hero__layout page-frame" data-about-hero-layout>
    <header class="premium-about-hero__heading">
      <h1 id="about-title" aria-label={hero.heading}>
        {headline.map((line) => (
          <span class="premium-about-hero__line">
            <span data-about-headline>{line} </span>
          </span>
        ))}
      </h1>
    </header>

    <figure class="premium-about-hero__portrait" data-about-portrait>
      <div class="premium-about-hero__composition" data-about-composition>
        <div class="premium-about-hero__atmosphere" data-about-gradient aria-hidden="true">
          <span class="premium-about-hero__glow premium-about-hero__glow--amber" />
          <span class="premium-about-hero__glow premium-about-hero__glow--coral" />
          <span class="premium-about-hero__glow premium-about-hero__glow--orange" />
        </div>
        <div class="premium-about-hero__registration" aria-hidden="true">
          <span>From one thought</span>
          <span>to something real.</span>
        </div>
        <!-- The approved plaque's source-pixel layer, framed to its alpha bounds.
             Layered raster presentation; this is not a new editable 3D model. -->
        <div
          class="premium-about-hero__plaque"
          data-about-plaque
          data-about-plaque-source="signature/emblem-plaque.png"
          aria-hidden="true"
        >
          <div class="premium-about-hero__plaque-frame">
            <Image
              src={plaque}
              alt=""
              widths={[450, 810]}
              sizes="(max-width: 639px) 55vw, (max-width: 1023px) 35vw, 440px"
              loading="eager"
              decoding="async"
              format="webp"
              quality={92}
              data-about-plaque-image
            />
          </div>
        </div>
        <div class="premium-about-hero__artwork" data-about-artwork>
          <FounderPortrait />
        </div>
        <div class="premium-about-hero__axis" aria-hidden="true">
          <span>02</span>
          <i />
        </div>
      </div>
      <figcaption data-about-caption>
        <span>{hero.caption}</span>
        <span aria-hidden="true">DrawnOut / The founders</span>
      </figcaption>
    </figure>

    <div class="premium-about-hero__intro" data-about-intro>
      {hero.paragraphs.map((paragraph) => (
        <p data-about-hero-paragraph>{paragraph}</p>
      ))}
    </div>

    <div class="premium-about-hero__signoff" data-about-signoff>
      <p>{hero.supportingLabel}</p>
      <a href="#our-beginning" class="premium-about-hero__story-link">
        Follow the thought <span aria-hidden="true">↓</span>
      </a>
    </div>
  </div>
</section>

<script is:inline>
  // The finite native arrival starts beside its markup. It must not race a
  // heavyweight shared module or a second image decode to a prepaint deadline.
  (() => {
    const hero = document.currentScript?.previousElementSibling;
    const page = hero?.closest('[data-about-page]');
    if (!hero?.matches('[data-about-hero]') || !page) return;
    page.dataset.aboutArrivalAt = String(performance.now());
    const controller = new AbortController();
    const { signal } = controller;
    const animations = new Set();
    const timers = new Set();
    let observer;
    let bootDeadline;
    let finished = false;
    let started = false;
    let suspended = false;
    const preference = matchMedia('(prefers-reduced-motion: reduce)');
    const connection = Reflect.get(navigator, 'connection');
    const allowed = () => !preference.matches && !connection?.saveData;
    const schedule = (callback, delay) => {
      const timer = setTimeout(() => {
        timers.delete(timer);
        if (!finished) callback();
      }, delay);
      timers.add(timer);
      return timer;
    };
    const settle = (reason) => {
      if (finished) return;
      finished = true;
      clearTimeout(bootDeadline);
      for (const timer of timers) clearTimeout(timer);
      timers.clear();
      for (const animation of animations) animation.cancel();
      animations.clear();
      hero.removeAttribute('data-about-prepaint');
      hero.dataset.aboutEntrance = started ? 'settled' : 'static';
      hero.dataset.aboutHeroPhase = 'settled';
      hero.dataset.aboutArrivalScene = 'settled';
      hero.dataset.aboutSettleReason = reason;
      hero.dataset.aboutEndedAt = performance.now().toFixed(2);
      if (hero.dataset.aboutBoot === 'pending') hero.dataset.aboutBoot = 'released';
    };
    const updateAtmosphere = () => {
      const box = hero.getBoundingClientRect();
      hero.dataset.aboutAmbient =
        !suspended && allowed() && !document.hidden && box.bottom > 0 && box.top < innerHeight
          ? 'running'
          : 'paused';
    };
    const dispose = (event) => {
      settle('navigation');
      suspended = true;
      hero.dataset.aboutAmbient = 'paused';
      // Keep the lightweight observer/listeners with a cached document, so its
      // atmosphere resumes on return while the finite arrival stays settled.
      if (event?.type === 'pagehide' && event.persisted) return;
      controller.abort();
      observer?.disconnect();
    };
    try {
      const navigation = performance.getEntriesByType('navigation')[0];
      const exclusion = !allowed()
        ? preference.matches
          ? 'reduced-motion'
          : 'save-data'
        : document.hidden
          ? 'hidden'
          : location.hash || scrollY > 0
            ? 'restored-scroll'
            : navigation?.type === 'back_forward'
              ? 'history'
              : typeof Element.prototype.animate !== 'function' ||
                  typeof IntersectionObserver !== 'function'
                ? 'unsupported'
                : document.activeElement && document.activeElement !== document.body
                  ? 'focused'
                  : undefined;
      if (typeof IntersectionObserver === 'function') {
        observer = new IntersectionObserver(updateAtmosphere, { threshold: 0 });
        observer.observe(hero);
      }
      const input = (event) => {
        if (event.type === 'scroll' && scrollX === 0 && scrollY === 0) return;
        settle('input');
      };
      window.addEventListener('wheel', input, { passive: true, signal });
      window.addEventListener('touchstart', input, { passive: true, signal });
      window.addEventListener('pointerdown', input, { capture: true, passive: true, signal });
      window.addEventListener('keydown', input, { capture: true, signal });
      window.addEventListener('scroll', input, { passive: true, signal });
      window.addEventListener(
        'resize',
        () => {
          settle('resize');
          updateAtmosphere();
        },
        { passive: true, signal },
      );
      window.addEventListener('pagehide', dispose, { signal });
      window.addEventListener(
        'pageshow',
        () => {
          suspended = false;
          updateAtmosphere();
        },
        { signal },
      );
      document.addEventListener('astro:before-swap', dispose, { signal });
      document.addEventListener('focusin', input, { signal });
      document.addEventListener(
        'visibilitychange',
        () => {
          if (document.hidden) settle('hidden');
          updateAtmosphere();
        },
        { signal },
      );
      const preferenceChanged = () => {
        if (!allowed()) settle(preference.matches ? 'reduced-motion' : 'save-data');
        updateAtmosphere();
      };
      preference.addEventListener('change', preferenceChanged, { signal });
      connection?.addEventListener?.('change', preferenceChanged, { signal });
      hero.addEventListener(
        'about:arrival-release',
        (event) => {
          settle(event.detail?.reason || 'cleanup');
        },
        { signal },
      );
      hero.addEventListener(
        'about:boot-handoff',
        () => {
          if (hero.dataset.aboutBoot !== 'pending' || finished) return;
          clearTimeout(bootDeadline);
          hero.dataset.aboutBoot = 'handed-off';
        },
        { signal },
      );
      updateAtmosphere();
      if (exclusion) {
        hero.dataset.aboutBoot = 'skipped';
        settle(exclusion);
        return;
      }
      const artwork = hero.querySelector('[data-about-artwork]');
      const raster = hero.querySelector('[data-about-portrait-raster]');
      const plaque = hero.querySelector('[data-about-plaque]');
      if (!artwork || !raster || !plaque) throw new Error('Missing About artwork');
      // A separate no-import entry acknowledges this controller. If every
      // external bundle is delayed or blocked the original550ms fail-open
      // still settles all content; an expired arrival can never re-hide later.
      hero.dataset.aboutBoot = 'pending';
      bootDeadline = setTimeout(() => settle('boot-deadline'), 550);
      hero.setAttribute('data-about-prepaint', '');
      const clock = document.timeline.currentTime;
      const play = (target, frames, options) => {
        const animation = target.animate(frames, { fill: 'both', ...options });
        animations.add(animation);
        if (typeof clock === 'number') animation.startTime = clock;
      };
      const enter = (target, delay, duration, travel, tilt = 0) => {
        const base = getComputedStyle(target).transform;
        const final = base === 'none' ? '' : base;
        play(
          target,
          [
            { opacity: 0, transform: `translateY(${travel}px) rotate(${tilt}deg) ${final}`.trim() },
            { opacity: 1, transform: final || 'none' },
          ],
          { delay, duration, easing: 'cubic-bezier(.22,.7,.22,1)' },
        );
      };
      enter(artwork, 0, 900, 22);
      // Approved raster plaque in2.5D; never described as a new rigged3D asset.
      enter(plaque, 700, 900, -26, -3);
      const gradient = hero.querySelector('[data-about-gradient]');
      if (gradient)
        play(
          gradient,
          [
            { opacity: 0, transform: 'scale(.93)' },
            { opacity: 1, transform: 'scale(1)' },
          ],
          { delay: 1200, duration: 1100, easing: 'cubic-bezier(.22,.7,.22,1)' },
        );
      hero.querySelectorAll('[data-about-headline]').forEach((line, index) => {
        enter(line, 2000 + index * 90, 740, 28);
      });
      hero.querySelectorAll('[data-about-hero-paragraph]').forEach((copy, index) => {
        enter(copy, 2500 + index * 100, 650, 12);
      });
      for (const detail of hero.querySelectorAll('[data-about-caption], [data-about-signoff]')) {
        play(detail, [{ opacity: 0 }, { opacity: 1 }], { delay: 2700, duration: 650 });
      }
      hero.removeAttribute('data-about-prepaint');
      started = true;
      hero.dataset.aboutStartedAt = performance.now().toFixed(2);
      hero.dataset.aboutEntrance = 'running';
      hero.dataset.aboutHeroPhase = 'arrival';
      hero.dataset.aboutArrivalScene = 'portrait';
      schedule(() => {
        hero.dataset.aboutArrivalScene = 'plaque';
      }, 700);
      schedule(() => {
        hero.dataset.aboutArrivalScene = 'atmosphere';
      }, 1200);
      schedule(() => {
        hero.dataset.aboutHeroPhase = 'transition';
        hero.dataset.aboutArrivalScene = 'copy';
      }, 2000);
      schedule(() => settle('complete'), 3500);

      // Watch the displayed responsive plaque directly. The SVG portrait's
      // preloadedURL uses one cache-coalesced load probe, without a second
      // image.decode or an alternative responsive-source request.
      const plaqueImage = plaque.querySelector('img');
      const portraitSource = raster.getAttribute('href');
      if (!plaqueImage || !portraitSource) {
        settle('asset-failure');
        return;
      }
      let pending = 2;
      const assetDeadline = schedule(() => settle('late-asset'), 450);
      const watch = (image) => {
        let loaded = false;
        const ready = () => {
          if (loaded) return;
          loaded = true;
          pending -= 1;
          if (!pending) {
            clearTimeout(assetDeadline);
            timers.delete(assetDeadline);
          }
        };
        image.addEventListener('error', () => settle('asset-failure'), { once: true, signal });
        image.addEventListener('load', ready, { once: true, signal });
        return () => {
          if (image.complete && image.naturalWidth > 0) ready();
          else if (image.complete) settle('asset-failure');
        };
      };
      const portraitProbe = new Image();
      const portraitReady = watch(portraitProbe);
      portraitProbe.src = portraitSource;
      portraitReady();
      watch(plaqueImage)();
    } catch {
      hero.dataset.aboutBoot = 'released';
      settle('boot-failure');
    }
  })();
</script>
<script>
  import '../../scripts/about-arrival';
</script>
