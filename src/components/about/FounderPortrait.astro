---
import { Image } from 'astro:assets';
import { Buffer } from 'node:buffer';
import { readFile } from 'node:fs/promises';
import { founderPortrait } from '../../data/founder-portrait';

// A trusted local environment setting permits private visual review. It is
// deliberately absent from production, including when the setting remains set.
let reviewSource: string | undefined;
if (import.meta.env.DEV && process.env.ABOUT_PORTRAIT_REVIEW_FILE && !founderPortrait) {
  const bytes = await readFile(process.env.ABOUT_PORTRAIT_REVIEW_FILE);
  if (bytes.subarray(0, 8).equals(Buffer.from([137, 80, 78, 71, 13, 10, 26, 10])))
    reviewSource = `data:image/png;base64,${bytes.toString('base64')}`;
}
const state = founderPortrait ? 'approved' : reviewSource ? 'private-review' : 'pending';
---

<div class="founder-portrait" data-founder-portrait data-portrait-state={state}>
  {founderPortrait ? (
    <Image
      src={founderPortrait.src}
      alt={founderPortrait.alt}
      widths={[480, 800, 1200]}
      sizes="(max-width: 767px) 94vw, (max-width: 1023px) 84vw, 52vw"
      format="webp"
      loading="eager"
      fetchpriority="high"
      class="portrait-art"
    />
  ) : reviewSource ? (
    <img
      src={reviewSource}
      width="1446"
      height="1087"
      alt="Private review candidate: editorial illustration of the two twin founders together, preserving their expressions, long hair and embroidered clothing."
      class="portrait-art"
      data-private-portrait-review
    />
  ) : (
    <svg
      class="portrait-pending"
      viewBox="0 0 800 600"
      role="img"
      aria-labelledby="portrait-pending-title"
    >
      <title id="portrait-pending-title">One thought becoming two connected paths</title>
      <path class="thought-path" d="M 30 500 C 130 500 100 360 220 350 S 400 395 400 280" />
      <path d="M 400 280 C 400 190 230 140 200 245 S 240 450 400 430" />
      <path d="M 400 280 C 400 180 580 130 610 240 S 570 450 400 430" />
      <circle cx="400" cy="280" r="9" />
    </svg>
  )}
  {import.meta.env.DEV && state !== 'approved' && (
    <p class="portrait-review-label">
      {reviewSource
        ? 'Private portrait review · approval pending'
        : 'Founder illustration awaiting approval'}
    </p>
  )}
</div>

<style>
  .founder-portrait {
    position: relative;
    width: 100%;
    aspect-ratio: 4 / 3;
    isolation: isolate;
  }
  .portrait-art,
  .portrait-pending {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }
  .portrait-pending {
    fill: none;
    stroke: var(--ink);
    stroke-width: 1.7;
    stroke-linecap: round;
  }
  .portrait-pending .thought-path {
    stroke: var(--accent-strong);
    stroke-width: 2.5;
  }
  .portrait-pending circle {
    fill: var(--accent-strong);
    stroke: none;
  }
  .portrait-review-label {
    margin: 12px 0 0;
    color: var(--muted);
    font-size: 11px;
    line-height: 1.6;
  }
</style>
