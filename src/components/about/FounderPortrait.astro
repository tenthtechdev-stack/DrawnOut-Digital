---
import { getImage } from 'astro:assets';
import { founderPortrait } from '../../data/founder-portrait';

const artwork = await getImage({
  src: founderPortrait.src,
  width: 1445,
  format: 'webp',
  quality: 85,
});
---

<link rel="preload" as="image" href={artwork.src} />
<div class="founder-portrait" data-founder-portrait data-portrait-state="approved">
  <svg
    class="portrait-art"
    viewBox="0 0 1445 1088"
    role="img"
    aria-labelledby="about-portrait-title"
    preserveAspectRatio="xMidYMid meet"
  >
    <title id="about-portrait-title">{founderPortrait.alt}</title>
    <defs>
      <!-- Broad brushes reveal the approved raster. These are masks,
           not independently drawn portrait contours or editable facial art. -->
      <mask
        id="about-portrait-reveal-mask"
        maskUnits="userSpaceOnUse"
        x="0"
        y="0"
        width="1445"
        height="1088"
        style="mask-type: luminance"
      >
        <g fill="none" stroke="white" stroke-linecap="round" stroke-linejoin="round">
          <path
            data-about-mask="contour"
            pathLength="1"
            stroke-width="135"
            d="M76 735C73 569 214 491 232 341S299 89 411 76C568 2 693 155 680 336S629 602 551 726"
          />
          <path
            data-about-mask="contour"
            pathLength="1"
            stroke-width="145"
            d="M593 732C677 622 685 390 780 264S984 117 1021 151C1114 100 1144 265 1180 377S1284 554 1361 720"
          />
          <path
            data-about-mask="face"
            pathLength="1"
            stroke-width="120"
            d="M398 160C359 218 373 297 420 347S536 400 572 339 568 221 526 194M382 253 558 229M410 321 567 304"
          />
          <path
            data-about-mask="face"
            pathLength="1"
            stroke-width="125"
            d="M895 256C834 301 842 405 889 461S995 475 1022 413 1030 321 1000 285M862 331 1034 361M885 407 1009 437"
          />
          <path
            data-about-mask="fabric"
            pathLength="1"
            stroke-width="230"
            d="M130 646C226 512 338 574 413 604S561 615 620 626C770 572 786 778 872 824S1128 727 1285 808M92 790C290 720 341 855 509 880S819 903 955 932 1256 916 1337 983"
          />
        </g>
        <rect width="1445" height="1088" fill="white" data-about-mask-complete />
      </mask>
    </defs>
    <!-- One optimized raster image; no photograph or duplicate portrait layers. -->
    <image
      href={artwork.src}
      width="1445"
      height="1088"
      preserveAspectRatio="xMidYMid meet"
      data-about-portrait-raster
    />
  </svg>
</div>

<style>
  .founder-portrait {
    position: relative;
    width: 100%;
    aspect-ratio: 1445 / 1088;
    isolation: isolate;
  }
  .portrait-art {
    display: block;
    width: 100%;
    height: 100%;
    overflow: visible;
  }
</style>
