---
interface Props {
  variant: 'a' | 'b';
}
const { variant } = Astro.props;
---

<aside class="review-bar" aria-label="Design concept review">
  <span>
    <span class="status-dot" aria-hidden="true"></span> Design study{' '}
    <span class="review-detail">/ Phase 0 · local preview</span>
  </span>
  <nav aria-label="Compare concepts">
    <a href="/concepts/a" aria-current={variant === 'a' ? 'page' : undefined}>
      A <span>— Afterglow</span>
    </a>
    <a href="/concepts/b" aria-current={variant === 'b' ? 'page' : undefined}>
      B <span>— Studio Edit</span>
    </a>
  </nav>
</aside>
<style>
  .review-bar {
    min-height: 42px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 10px;
    padding: 7px var(--gutter);
    background: #252522;
    color: #eeeee9;
    font-size: 10px;
    letter-spacing: 0.02em;
  }
  .review-bar > span {
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .review-detail {
    color: #b9b9b0;
  }
  .status-dot {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: #ff9a60;
  }
  nav {
    display: flex;
    gap: 5px;
  }
  a {
    padding: 6px 10px;
    border-radius: 3px;
    text-decoration: none;
    color: #b9b9b0;
  }
  a[aria-current] {
    color: #fff;
    background: #454540;
  }
  a:focus-visible {
    outline-color: #ff9a60;
  }
  @media (max-width: 640px) {
    .review-detail,
    nav a span {
      display: none;
    }
    .review-bar {
      font-size: 10px;
    }
    nav a {
      padding: 6px 13px;
    }
  }
</style>
