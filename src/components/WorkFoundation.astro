---
import SectionIntro from './SectionIntro.astro';
interface Props {
  intro?: boolean;
  storytelling?: boolean;
}
const { intro = true, storytelling = false } = Astro.props;
const PreviewWork = import.meta.env.DEV
  ? storytelling
    ? (await import('./EditorialWork.astro')).default
    : (await import('./PreviewWork.astro')).default
  : undefined;
---

<section class="work-foundation page-frame" data-work aria-label="Selected-work foundation">
  {intro && (
    <SectionIntro
      id="work-title"
      eyebrow="01 / Selected work"
      title="The work speaks."
      accent="We'll let it."
      note={
        storytelling
          ? 'We believe a portfolio should do more than display attractive images. It should reveal the thinking behind them.'
          : 'Every project starts with a question. Every outcome has a reason.'
      }
    />
  )}
  {PreviewWork ? (
    <PreviewWork />
  ) : (
    <p class="empty-work">
      Project stories are being prepared. Selected work will appear here after studio approval.
    </p>
  )}
</section>
<style>
  .work-foundation {
    padding-block: var(--space-6) var(--space-7);
  }
  .empty-work {
    border-top: 1px solid var(--line);
    padding-top: var(--space-4);
    font-size: var(--type-body);
    line-height: var(--leading-body);
    max-width: 680px;
  }
</style>
