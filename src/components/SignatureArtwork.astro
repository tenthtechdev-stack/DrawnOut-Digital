---
import { Image } from 'astro:assets';
import hand from '../assets/signature/hand-empty.png';
import plaque from '../assets/signature/emblem-plaque.png';

interface Props {
  variant?: 'intro' | 'footer';
}
const { variant = 'footer' } = Astro.props;
const sizes =
  variant === 'intro' ? '(max-width: 767px) 105vw, 550px' : '(max-width: 767px) 100vw, 60vw';
---

<!-- Independently masked source-pixel layers: a fixed-pose 2D study, not a hand rig.
     There is no intact composite or substitute decorative frame in this component. -->
<div
  class:list={['signature-artwork', `signature-artwork--${variant}`]}
  data-signature-artwork
  data-signature-asset="separated-raster-prototype"
  aria-hidden="true"
>
  <div class="signature-glow" data-signature-glow></div>
  <div class="signature-layer signature-plaque" data-signature-plaque>
    <Image
      src={plaque}
      alt=""
      widths={[450, 810]}
      sizes={sizes}
      loading={variant === 'intro' ? 'eager' : 'lazy'}
      decoding="async"
      format="webp"
      quality={92}
      data-signature-plaque-image
    />
  </div>
  <div class="signature-layer signature-hand" data-signature-hand>
    <Image
      src={hand}
      alt=""
      widths={[450, 810]}
      sizes={sizes}
      loading={variant === 'intro' ? 'eager' : 'lazy'}
      decoding="async"
      format="webp"
      quality={92}
      data-signature-hand-image
    />
  </div>
</div>

<style>
  .signature-artwork {
    width: 100%;
    aspect-ratio: 9 / 16;
    position: relative;
    isolation: isolate;
    pointer-events: none;
    transform-origin: 50% 62%;
  }
  .signature-layer {
    position: absolute;
    inset: 0;
  }
  .signature-layer img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }
  .signature-plaque {
    z-index: 1;
  }
  .signature-hand {
    z-index: 2;
  }
  .signature-glow {
    position: absolute;
    inset: 12% -18% 20%;
    background: radial-gradient(ellipse at 50% 42%, #ff740024, #ff74000a 38%, transparent 68%);
    z-index: 0;
  }
  @media (prefers-reduced-motion: reduce) {
    .signature-artwork,
    .signature-layer {
      transform: none !important;
    }
  }
</style>
