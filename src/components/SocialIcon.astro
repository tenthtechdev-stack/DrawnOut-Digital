---
interface Props {
  name: 'Facebook' | 'Instagram' | 'LinkedIn';
}
const { name } = Astro.props;
---

<svg viewBox="0 0 24 24" width="20" height="20" fill="none" aria-hidden="true" focusable="false">
  {name === 'Facebook' && (
    <path
      fill="currentColor"
      d="M14.1 22v-9h3l.5-3.5h-3.5V7.3c0-1 .3-1.7 1.8-1.7h1.9V2.5a25 25 0 0 0-2.8-.2c-2.8 0-4.7 1.7-4.7 4.8v2.4H7.2V13h3.1v9h3.8Z"
    />
  )}
  {name === 'Instagram' && (
    <>
      <rect x="3" y="3" width="18" height="18" rx="5" stroke="currentColor" stroke-width="1.7" />
      <circle cx="12" cy="12" r="4.2" stroke="currentColor" stroke-width="1.7" />
      <circle cx="17.6" cy="6.5" r="1.1" fill="currentColor" />
    </>
  )}
  {name === 'LinkedIn' && (
    <>
      <rect x="3" y="9" width="4" height="12" rx=".3" fill="currentColor" />
      <circle cx="5" cy="4.8" r="2.2" fill="currentColor" />
      <path
        fill="currentColor"
        d="M10 9h3.6v1.6c.6-1 1.8-1.9 3.5-1.9 3 0 3.9 1.9 3.9 4.9V21h-3.8v-6.5c0-1.4-.2-2.8-1.8-2.8-1.6 0-1.8 1.4-1.8 2.7V21H10V9Z"
      />
    </>
  )}
</svg>
