---
import { Image, getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
interface Props {
  poster: ImageMetadata;
  alt: string;
  priority?: boolean;
  aspectRatio?: string;
  availability?: 'placeholder' | 'approved';
  sizes?: string;
  video?: { mp4?: string; webm?: string; captions?: string };
  mobilePoster?: ImageMetadata;
  motion?: { landscape: string; portrait: string; source: string };
  motionId?: string;
}
const {
  poster,
  alt,
  priority = false,
  aspectRatio = '1440 / 811',
  availability = 'placeholder',
  sizes = '(max-width: 640px) 90vw, (max-width: 1023px) 85vw, 70vw',
  video,
  mobilePoster,
  motion,
  motionId,
} = Astro.props;
const hasMotion = availability === 'approved' && Boolean(motion && motionId);
const widths = [...new Set([480, 800, 1200, 1440, poster.width])]
  .filter((width) => width <= poster.width)
  .sort((a, b) => a - b);
const hasApprovedVideo = availability === 'approved' && Boolean(video?.mp4 || video?.webm);
const mobileSources = mobilePoster
  ? await Promise.all(
      [480, 800]
        .filter((width) => width <= mobilePoster.width)
        .map(async (width) => {
          const image = await getImage({ src: mobilePoster, width, format: 'webp' });
          return `${image.src} ${width}w`;
        }),
    )
  : [];
---

<div
  class="media-slot"
  data-media-slot
  data-portfolio-motion={hasMotion || undefined}
  style={`--media-ratio: ${aspectRatio}; --mobile-media-ratio: ${mobilePoster ? `${mobilePoster.width} / ${mobilePoster.height}` : aspectRatio}`}
>
  <picture>
    {mobilePoster && (
      <source
        media="(max-width: 639px)"
        type="image/webp"
        srcset={mobileSources.join(', ')}
        sizes={sizes}
        width={mobilePoster.width}
        height={mobilePoster.height}
      />
    )}
    <Image
      src={poster}
      alt={hasApprovedVideo ? '' : alt}
      widths={widths}
      sizes={sizes}
      loading={priority ? 'eager' : 'lazy'}
      fetchpriority={priority ? 'high' : 'auto'}
      format="webp"
    />
  </picture>
  {hasMotion && motion && (
    <video
      id={motionId}
      class="portfolio-motion-video"
      data-portfolio-video
      data-landscape={`/media/portfolio/${motion.landscape}`}
      data-portrait={`/media/portfolio/${motion.portrait}`}
      data-motion-state="poster"
      muted
      autoplay
      playsinline
      loop
      preload="none"
      aria-hidden="true"
      tabindex="-1"
      width="960"
      height="540"
    />
  )}
  {hasApprovedVideo && (
    <video
      class="media-video"
      controls
      playsinline
      preload="none"
      poster={poster.src}
      aria-label={alt}
    >
      {video?.webm && <source src={video.webm} type="video/webm" />}
      {video?.mp4 && <source src={video.mp4} type="video/mp4" />}
      {video?.captions && (
        <track kind="captions" src={video.captions} srclang="en" label="English" default />
      )}
      Your browser cannot play this video. The portfolio poster remains available.
    </video>
  )}
  {availability === 'placeholder' && <span class="preview-tag">Visual preview</span>}
</div>
<script>
  import '../scripts/portfolio-motion';
</script>
<style>
  .media-slot {
    position: relative;
    aspect-ratio: var(--media-ratio);
    overflow: hidden;
    background: #e7e4dd;
  }
  .media-slot img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }
  .media-slot picture {
    display: contents;
  }
  @media (max-width: 639px) {
    .media-slot {
      aspect-ratio: var(--mobile-media-ratio);
    }
  }
  .preview-tag {
    position: absolute;
    right: 14px;
    bottom: 14px;
    padding: 5px 9px;
    border-radius: 3px;
    background: #fffef4;
    color: #302e29;
    font-size: 9px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .portfolio-motion-video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
    opacity: 0;
    pointer-events: none;
  }
  .portfolio-motion-video[data-motion-state='playing'] {
    opacity: 1;
  }
  @media (prefers-reduced-motion: reduce) {
    .portfolio-motion-video {
      display: none;
    }
  }
  .media-video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }
</style>
