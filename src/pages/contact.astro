---
import SiteLayout from '../layouts/SiteLayout.astro';
import EnquiryForm from '../components/contact/EnquiryForm.astro';
import Arrow from '../components/Arrow.astro';
import FirstThought from '../components/contact/FirstThought.astro';
import { contact } from '../data/contact';
---

<SiteLayout
  title="Contact — DrawnOut Digital"
  description="Have something in mind? You don't need a perfect brief. You just need somewhere to start. Get in touch with DrawnOut Digital."
>
  <section class="contact-intro page-frame" aria-labelledby="contact-title">
    <div class="contact-kicker">
      <p class="eyebrow">Contact / Start a conversation</p>
      <span class="contact-edition" aria-hidden="true">
        A first thought. A new possibility.
      </span>
    </div>
    <div class="contact-intro-grid">
      <h1 id="contact-title">
        Have something
        <br />
        <span>in mind?</span>
      </h1>
      <div class="contact-intro-note">
        <p>You don't need a perfect brief. You just need somewhere to start.</p>
        <a class="enquiry-jump" href="#enquiry">
          <span>Tell us what you're thinking</span>
          <span aria-hidden="true">↓</span>
        </a>
      </div>
      <div class="contact-thought">
        <FirstThought />
      </div>
    </div>
  </section>
  <div class="contact-body page-frame">
    <section id="enquiry" class="contact-enquiry" aria-labelledby="enquiry-heading">
      <EnquiryForm email={contact.email} />
    </section>
    <aside class="contact-direct" aria-labelledby="direct-heading">
      <p class="eyebrow">A direct line</p>
      <h2 id="direct-heading" data-motion-text="heading" data-motion-split="lines">
        Every idea starts
        <br />
        with a hello.
      </h2>
      <dl class="contact-methods">
        <div>
          <dt>Email</dt>
          <dd>
            <a href={`mailto:${contact.email}`}>
              <span>{contact.email}</span>
              <Arrow />
            </a>
          </dd>
        </div>
        <div>
          <dt>Phone</dt>
          <dd>
            <a href={`tel:${contact.phone}`}>
              <span>{contact.phone}</span>
              <Arrow />
            </a>
          </dd>
        </div>
        <div>
          <dt>WhatsApp</dt>
          <dd>
            <a
              href={contact.whatsapp}
              aria-label="Start a conversation with DrawnOut Digital on WhatsApp"
            >
              <span>Message us on WhatsApp</span>
              <Arrow />
            </a>
          </dd>
        </div>
      </dl>
      <nav class="contact-social" aria-label="DrawnOut Digital social profiles">
        <p class="eyebrow">Find us elsewhere</p>
        <ul>
          {contact.social.map(({ label, href }) => (
            <li>
              <a href={href} aria-label={`DrawnOut Digital on ${label}`}>
                <span>{label}</span>
                <Arrow />
              </a>
            </li>
          ))}
        </ul>
      </nav>
    </aside>
  </div>
</SiteLayout>
<style>
  .contact-intro {
    padding-block: clamp(36px, 4.5vw, 64px) clamp(32px, 4vw, 56px);
  }
  .contact-kicker {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    margin-bottom: 28px;
    color: var(--accent-strong);
  }
  .contact-kicker p {
    margin: 0;
  }
  .contact-edition {
    color: var(--muted);
    font-size: 11px;
    letter-spacing: -0.01em;
  }
  .contact-intro-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) minmax(0, 0.9fr);
    column-gap: clamp(32px, 5vw, 80px);
    row-gap: 24px;
    padding-bottom: clamp(32px, 4vw, 56px);
    border-bottom: 1px solid var(--line);
  }
  h1 {
    grid-column: 1;
    grid-row: 1;
    margin: 0;
    font-size: clamp(3.6rem, 7.6vw, 7.9rem);
    font-weight: 500;
    line-height: 1.03;
    letter-spacing: var(--tracking-display);
  }
  h1 > span {
    color: var(--accent-strong);
  }
  .contact-intro-note {
    grid-column: 1;
    grid-row: 2;
    max-width: 390px;
  }
  .contact-intro-note p {
    margin: 0;
    font-size: clamp(1.0625rem, 1.55vw, 1.3rem);
    line-height: 1.6;
    letter-spacing: -0.025em;
  }
  .contact-thought {
    grid-column: 2;
    grid-row: 1 / span 2;
    min-width: 0;
    align-self: center;
  }
  .enquiry-jump {
    display: inline-flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    min-height: 44px;
    margin-top: 20px;
    font-size: var(--type-small);
    line-height: 1.6;
    text-decoration: none;
    border-bottom: 1px solid currentColor;
  }
  .enquiry-jump > span:last-child {
    font-size: 24px;
    flex-shrink: 0;
  }
  .contact-body {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.45fr);
    gap: clamp(48px, 8vw, 128px);
    padding-bottom: var(--space-7);
  }
  .contact-enquiry {
    grid-column: 2;
    grid-row: 1;
    min-width: 0;
  }
  .contact-direct {
    grid-column: 1;
    grid-row: 1;
    min-width: 0;
  }
  .contact-direct {
    padding-top: 4px;
  }
  .contact-direct > .eyebrow {
    margin: 0 0 22px;
    color: var(--accent-strong);
  }
  h2 {
    margin: 0 0 36px;
    font-size: clamp(1.75rem, 2.5vw, 2.75rem);
    line-height: 1.18;
    letter-spacing: -0.05em;
    font-weight: 500;
  }
  .contact-methods {
    margin: 0;
  }
  .contact-methods > div {
    padding-block: 20px 15px;
    border-top: 1px solid var(--line);
  }
  dt {
    color: var(--muted);
    font-size: var(--type-small);
    margin-bottom: 6px;
  }
  dd {
    margin: 0;
  }
  .contact-methods a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    min-height: 44px;
    font-size: clamp(0.875rem, 1.25vw, 1.125rem);
    text-decoration: none;
  }
  .contact-methods a span {
    overflow-wrap: anywhere;
  }
  .contact-direct :global(svg) {
    width: 18px;
    height: 18px;
    flex-shrink: 0;
    transition: transform var(--duration-ui) var(--ease-ui);
  }
  .contact-social {
    margin-top: 48px;
  }
  .contact-social p {
    margin: 0 0 12px;
    color: var(--muted);
  }
  .contact-social ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0 22px;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .contact-social a {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    min-height: 44px;
    font-size: var(--type-small);
    text-decoration: none;
  }
  .contact-social :global(svg) {
    width: 13px;
    height: 13px;
  }
  a:is(:hover, :focus-visible) {
    color: var(--accent-strong);
    text-decoration: underline;
  }
  a:is(:hover, :focus-visible) :global(svg) {
    transform: translate(2px, -2px);
  }
  @media (max-width: 899px) {
    .contact-intro-grid {
      grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
      column-gap: 28px;
      row-gap: 26px;
    }
    h1 {
      grid-column: 1 / -1;
      font-size: clamp(2.65rem, 8.8vw, 5rem);
    }
    .contact-intro-note {
      grid-column: 1;
      grid-row: 2;
    }
    .contact-thought {
      grid-column: 2;
      grid-row: 2;
      --thought-height: 184px;
    }
    .contact-body {
      grid-template-columns: minmax(0, 1fr);
      gap: 56px;
    }
    .contact-enquiry,
    .contact-direct {
      grid-column: auto;
      grid-row: auto;
    }
    .contact-direct {
      padding-top: 32px;
      border-top: 1px solid var(--line);
    }
    .contact-methods a {
      font-size: 1rem;
    }
  }
  @media (max-width: 639px) {
    .contact-intro {
      padding-top: 30px;
      padding-bottom: 28px;
    }
    .contact-kicker {
      margin-bottom: 22px;
    }
    .contact-edition {
      display: none;
    }
    .contact-intro-grid {
      gap: 24px 20px;
      padding-bottom: 30px;
    }
    h1 {
      font-size: clamp(2.65rem, 11.4vw, 4.3rem);
      line-height: 1.07;
    }
    .contact-intro-note p {
      font-size: 1rem;
      line-height: 1.6;
    }
    .contact-thought {
      --thought-height: 164px;
    }
    .enquiry-jump {
      width: 100%;
      gap: 10px;
      margin-top: 14px;
      font-size: 12px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    a:is(:hover, :focus-visible) :global(svg) {
      transform: none;
    }
  }
</style>
