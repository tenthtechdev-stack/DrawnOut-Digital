---
import SiteLayout from '../layouts/SiteLayout.astro';
import RouteIntro from '../components/RouteIntro.astro';
import { capabilities } from '../data/site';
---

<SiteLayout
  title="Services — DrawnOut Digital"
  description="Brand identity, digital design, campaigns, storytelling, and creative direction. The DrawnOut service foundation."
>
  <RouteIntro
    eyebrow="Design. Strategy. Storytelling. Digital."
    title="We think beyond the brief."
    description="Good design gets attention. Great thinking gives people a reason to stay."
  />
  <div class="service-foundation page-frame">
    {capabilities.map((item, index) => (
      <section id={item.id}>
        <p class="eyebrow">0{index + 1}</p>
        <div>
          <h2>{item.title}</h2>
          <p>{item.proposition}</p>
        </div>
      </section>
    ))}
  </div>
</SiteLayout>
<style>
  .service-foundation {
    padding-bottom: var(--space-6);
  }
  section {
    display: grid;
    grid-template-columns: 70px 1fr;
    padding-block: 30px;
    border-top: 1px solid var(--line);
    gap: 20px;
  }
  section > p {
    margin: 7px 0 0;
    color: var(--muted);
  }
  h2 {
    font-size: clamp(1.5rem, 3vw, 2.7rem);
    line-height: 1.25;
    letter-spacing: -0.045em;
    font-weight: 500;
    margin: 0;
  }
  section div > p {
    font-size: var(--type-body);
    line-height: var(--leading-body);
    margin: 18px 0 0;
    color: var(--muted);
  }
  @media (max-width: 639px) {
    section {
      grid-template-columns: 30px 1fr;
      gap: 15px;
    }
  }
</style>
