---
import type { GetStaticPaths } from 'astro';
import type { CollectionEntry } from 'astro:content';
import SiteLayout from '../../layouts/SiteLayout.astro';
import CaseStudy from '../../components/case/CaseStudy.astro';
import { getPublicWorkProjects } from '../../lib/projects';

export const getStaticPaths = (async () => {
  const projects = await getPublicWorkProjects();
  return projects.map((project) => ({
    params: { slug: project.data.slug },
    props: { project, projects },
  }));
}) satisfies GetStaticPaths;

interface Props {
  project: CollectionEntry<'projects'>;
  projects: CollectionEntry<'projects'>[];
}
const { project, projects } = Astro.props;
// Free-form metadata can contain factual or attribution claims. Until both
// reviews are complete, use only the approved visual title and description.
const metadataApproved = project.data.contentVerified && project.data.creditApproved;
---

<SiteLayout
  title={(metadataApproved && project.data.seoTitle) || `${project.data.title} — DrawnOut Digital`}
  description={(metadataApproved && project.data.seoDescription) || project.data.summary}
>
  <CaseStudy project={project} projects={projects} />
</SiteLayout>
