---
import '../styles/global.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import MotionEnhancement from '../components/MotionEnhancement.astro';
import SignatureIntro from '../components/SignatureIntro.astro';
import SignatureIntroBoot from '../components/SignatureIntroBoot.astro';
import { site } from '../data/site';
interface Props {
  title?: string;
  description?: string;
  enableLoader?: boolean;
}
const {
  title = 'DrawnOut Digital — Independent creative & digital studio',
  description = site.description,
  enableLoader = true,
} = Astro.props;
const portfolioReview =
  Astro.url.pathname === '/work' ||
  Astro.url.pathname.startsWith('/work/') ||
  Astro.url.pathname.startsWith('/_preview/work/');
const motionEnabled = !Astro.url.pathname.startsWith('/concepts/');
const loaderEnabled =
  enableLoader &&
  motionEnabled &&
  !Astro.url.pathname.startsWith('/_preview/') &&
  !/^\/404(?:\/|\.html)?$/.test(Astro.url.pathname);
const replayURL = new URL(Astro.url);
replayURL.searchParams.set('showIntro', '1');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="theme-color" content="#f7f5f1" />
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <title>{title}</title>
    {motionEnabled && <SignatureIntroBoot enableIntro={loaderEnabled} />}
    {motionEnabled && Astro.url.pathname === '/' && <script is:inline>
      (() => {
        const html = document.documentElement;
        try {
          if (html.dataset.signatureIntro === 'pending') return;
          const preference = matchMedia('(prefers-reduced-motion: reduce)');
          const connection = Reflect.get(navigator, 'connection');
          const restored = performance
            .getEntriesByType('navigation')
            .some((entry) => Reflect.get(entry, 'type') === 'back_forward');
          if (
            preference.matches ||
            connection?.saveData ||
            document.hidden ||
            location.hash ||
            restored ||
            !('IntersectionObserver' in window)
          )
            return;

          html.dataset.heroBoot = 'pending';
          html.dataset.heroBootUntil = String(performance.now() + 900);
          html.dataset.heroEntrance = 'pending';
          const release = () => {
            if (html.dataset.heroBoot === 'pending') {
              delete html.dataset.heroBoot;
              delete html.dataset.heroBootUntil;
              html.dataset.heroEntrance = 'static';
            }
            clearTimeout(timer);
            document.removeEventListener('focusin', onFocus);
            document.removeEventListener('visibilitychange', onVisibility);
            window.removeEventListener('scroll', onScroll);
            window.removeEventListener('pagehide', release);
            preference.removeEventListener('change', release);
          };
          const onFocus = (event) => {
            if (event.target instanceof Element && event.target.closest('[data-hero]')) release();
          };
          const onScroll = () => {
            if (scrollY >= 60) release();
          };
          const onVisibility = () => {
            if (document.hidden) release();
          };
          const timer = setTimeout(release, 900);
          document.addEventListener('focusin', onFocus);
          document.addEventListener('visibilitychange', onVisibility);
          window.addEventListener('scroll', onScroll, { passive: true });
          window.addEventListener('pagehide', release);
          preference.addEventListener('change', release);
        } catch {
          delete html.dataset.heroBoot;
          delete html.dataset.heroBootUntil;
          html.dataset.heroEntrance = 'static';
        }
      })();
    </script>}
  </head>
  <body>
    <a class="skip-link" href="#main">
      Skip to content
    </a>
    {import.meta.env.DEV && (
      <aside class="phase-notice" aria-label="Design review status">
        <div class="page-frame">
          <span>
            <i aria-hidden="true"></i> Afterglow /{' '}
            {motionEnabled ? 'Signature experience' : portfolioReview ? 'Phase 3' : 'Phase 2'}
          </span>
          <span>
            {loaderEnabled && (
              <a href={replayURL.pathname + replayURL.search} data-intro-replay>
                Replay loader
              </a>
            )}{' '}
            {motionEnabled
              ? 'Signature experience review'
              : portfolioReview
                ? 'Work & case-study review'
                : 'Homepage storytelling review'}
          </span>
        </div>
      </aside>
    )}
    {loaderEnabled && <SignatureIntro />}
    <SiteHeader />
    <main id="main" tabindex="-1" data-motion-root={motionEnabled || undefined}>
      <slot />
    </main>
    <SiteFooter />
    {motionEnabled && <MotionEnhancement />}
  </body>
</html>
<style>
  .phase-notice {
    background: var(--ink);
    color: var(--cream);
  }
  .phase-notice > div {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 20px;
    min-height: 36px;
    font-size: 10px;
  }
  .phase-notice span:first-child {
    display: flex;
    align-items: center;
    gap: 9px;
  }
  .phase-notice i {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--amber);
  }
  .phase-notice a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    margin-right: 16px;
  }
  .phase-notice span:last-child {
    color: var(--inverse-muted);
  }
  @media (max-width: 359px) {
    .phase-notice span:last-child {
      display: none;
    }
  }
</style>
