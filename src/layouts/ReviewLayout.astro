---
import '../styles/global.css';
interface Props {
  title: string;
}
const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <meta
      name="description"
      content="DrawnOut Digital — local design foundation and creative direction review."
    />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">
      Skip to content
    </a>
    <slot />
  </body>
</html>
